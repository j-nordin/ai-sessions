#!/usr/bin/env python3
"""ai-sessions — overview and recovery of AI CLI coding sessions.

Lists recent sessions across all projects with titles and last-activity
times, flags sessions that were still open when the machine went down,
and resumes a chosen session via fzf.

Backends are pluggable; currently implemented: claude (Claude Code).
"""

import argparse
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

UUID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
)

STATUS_RUNNING = "running"
STATUS_CRASHED = "crashed"  # was open when the machine/process died uncleanly
STATUS_CLOSED = "closed"

HEAD_BYTES = 8 * 1024
TAIL_BYTES = 64 * 1024
TAIL_BYTES_MAX = 1024 * 1024

GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
DIM = "\033[2m"
BOLD = "\033[1m"
NC = "\033[0m"


@dataclass
class Session:
    backend: str
    session_id: str
    cwd: str
    title: str
    created: float | None  # epoch seconds
    last_active: float | None
    status: str = STATUS_CLOSED
    has_messages: bool = True
    transcript_path: str = ""
    match_count: int = 0
    snippet: str = ""
    score: float = 0.0
    term_hits: int = 0   # query terms this session matched
    term_total: int = 0  # query terms searched for
    match_note: str = ""  # label instead of a count, for a non-content hit

    @property
    def match_label(self) -> str:
        if self.match_note:
            return self.match_note
        if self.term_total > 1:
            return f"{self.term_hits}/{self.term_total}·{self.match_count}"
        return str(self.match_count)


# --------------------------------------------------------------------------
# Backend framework
# --------------------------------------------------------------------------


class Backend:
    """A source of AI CLI sessions. Subclass per tool."""

    name = "?"

    def discover(self) -> list[Session]:
        raise NotImplementedError

    def resume_argv(self, session: Session) -> list[str]:
        raise NotImplementedError

    def searchable_text(self, obj: dict) -> str | None:
        """Conversation text of one transcript line, or None if the line
        is not conversation (metadata, tool output, ...)."""
        raise NotImplementedError


# --------------------------------------------------------------------------
# Claude Code backend
# --------------------------------------------------------------------------


class ClaudeBackend(Backend):
    """Reads Claude Code session transcripts and its live-process registry.

    Data layout (Claude Code >= 2.x):
      ~/.claude/projects/<dir>/<uuid>.jsonl   one transcript per session
      ~/.claude/sessions/<pid>.json           registry of running sessions

    Transcript notes:
      - message lines carry an ISO `timestamp` and the session `cwd`
      - metadata lines (`ai-title`, `agent-name`, `last-prompt`) carry no
        timestamp and are rewritten in place long after the last message,
        so file mtime overstates the last interaction — the last line
        *with* a timestamp is the real last activity
      - subagent transcripts live in subdirectories and are excluded by
        only globbing depth-1 UUID-named files
    """

    name = "claude"

    def __init__(self):
        self.claude_dir = Path(
            os.environ.get("CLAUDE_DIR", "~/.claude")
        ).expanduser()

    def resume_argv(self, session: Session) -> list[str]:
        return ["claude", "--resume", session.session_id]

    def discover(self) -> list[Session]:
        sessions = []
        for transcript in self._transcripts():
            try:
                session = self._parse_transcript(transcript)
            except OSError:
                continue
            if session:
                sessions.append(session)
        self._apply_registry(sessions)
        return sessions

    def _transcripts(self):
        projects = self.claude_dir / "projects"
        if not projects.is_dir():
            return
        try:
            project_dirs = sorted(projects.iterdir())
        except OSError:
            return
        for project_dir in project_dirs:
            try:
                entries = sorted(project_dir.iterdir())
            except OSError:
                continue  # e.g. root-owned dir from a devcontainer
            for entry in entries:
                if entry.suffix == ".jsonl" and UUID_RE.match(entry.stem):
                    yield entry

    def _parse_transcript(self, path: Path) -> Session | None:
        session_id = path.stem
        head_lines = self._read_head(path)
        tail_lines = self._read_tail(path)

        created = None
        cwd = ""
        first_user_text = ""
        meta = {}  # last-seen ai-title / agent-name / last-prompt
        has_messages = False

        for obj in head_lines:
            ts = _parse_ts(obj.get("timestamp"))
            if created is None and ts is not None:
                created = ts
            if not cwd and isinstance(obj.get("cwd"), str):
                cwd = obj["cwd"]
            if not first_user_text and obj.get("type") == "user":
                first_user_text = _message_text(obj)
            self._collect_meta(obj, meta)

        last_active = None
        for obj in reversed(tail_lines):
            ts = _parse_ts(obj.get("timestamp"))
            if ts is not None:
                last_active = ts
                break
        for obj in tail_lines:
            self._collect_meta(obj, meta)
            if obj.get("type") in ("user", "assistant"):
                has_messages = True
                if not cwd and isinstance(obj.get("cwd"), str):
                    cwd = obj["cwd"]

        has_messages = has_messages or created is not None
        if last_active is None:
            # Degenerate transcript (e.g. a title line and nothing else).
            last_active = path.stat().st_mtime

        title = (
            meta.get("ai-title")
            or meta.get("agent-name")
            or meta.get("last-prompt")
            or first_user_text
        )
        return Session(
            backend=self.name,
            session_id=session_id,
            cwd=cwd,
            title=_clean_text(title),
            created=created,
            last_active=last_active,
            has_messages=has_messages,
            transcript_path=str(path),
        )

    def searchable_text(self, obj: dict) -> str | None:
        kind = obj.get("type")
        if kind == "ai-title":
            return obj.get("aiTitle")
        if kind == "last-prompt":
            return obj.get("lastPrompt")
        if kind not in ("user", "assistant"):
            return None
        content = (obj.get("message") or {}).get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            # Tool results come back as user-role lines with tool_result
            # blocks — that's tool output, not conversation.
            texts = [
                block.get("text", "")
                for block in content
                if isinstance(block, dict) and block.get("type") == "text"
            ]
            return "\n".join(t for t in texts if t) or None
        return None

    @staticmethod
    def _collect_meta(obj: dict, meta: dict):
        kind = obj.get("type")
        if kind == "ai-title" and obj.get("aiTitle"):
            meta["ai-title"] = obj["aiTitle"]
        elif kind == "agent-name" and obj.get("agentName"):
            meta["agent-name"] = obj["agentName"]
        elif kind == "last-prompt" and obj.get("lastPrompt"):
            meta["last-prompt"] = obj["lastPrompt"]

    @staticmethod
    def _read_head(path: Path) -> list[dict]:
        with open(path, "rb") as fh:
            data = fh.read(HEAD_BYTES)
            truncated = len(data) == HEAD_BYTES
        lines = data.decode("utf-8", errors="replace").split("\n")
        if truncated:
            lines = lines[:-1]  # drop partial final line
        return _parse_lines(lines)

    @staticmethod
    def _read_tail(path: Path) -> list[dict]:
        size = path.stat().st_size
        window = TAIL_BYTES
        while True:
            with open(path, "rb") as fh:
                fh.seek(max(0, size - window))
                data = fh.read()
            lines = data.decode("utf-8", errors="replace").split("\n")
            if size > window:
                lines = lines[1:]  # drop partial first line
            parsed = _parse_lines(lines)
            if any(_parse_ts(o.get("timestamp")) for o in parsed):
                return parsed
            if window >= size or window >= TAIL_BYTES_MAX:
                return parsed
            window = min(window * 4, TAIL_BYTES_MAX)

    def _apply_registry(self, sessions: list[Session]):
        """Mark sessions as running or crashed from the live-process registry.

        Claude Code writes ~/.claude/sessions/<pid>.json while a session is
        open and removes it on clean exit. An entry whose pid is gone (or
        whose last update predates the current boot) means the session never
        shut down cleanly — it was open when the machine went down.
        """
        registry_dir = self.claude_dir / "sessions"
        if not registry_dir.is_dir():
            return
        by_id = {s.session_id: s for s in sessions}
        boot_time = _boot_time()
        for entry_path in sorted(registry_dir.glob("*.json")):
            try:
                entry = json.loads(entry_path.read_text())
            except (OSError, ValueError):
                continue
            session_id = entry.get("sessionId")
            if not session_id:
                continue
            pid = entry.get("pid")
            updated_at = (entry.get("updatedAt") or 0) / 1000.0
            alive = _pid_is_claude(pid) and (
                boot_time is None or updated_at >= boot_time
            )
            session = by_id.get(session_id)
            if session is None:
                # Registry entry without a transcript on disk — synthesize a
                # minimal row so a crashed session is never invisible.
                session = Session(
                    backend=self.name,
                    session_id=session_id,
                    cwd=entry.get("cwd", ""),
                    title=_clean_text(entry.get("name", "")),
                    created=(entry.get("startedAt") or 0) / 1000.0 or None,
                    last_active=updated_at or None,
                )
                sessions.append(session)
                by_id[session_id] = session
            if alive:
                session.status = STATUS_RUNNING
            elif session.status != STATUS_RUNNING:
                # If the transcript shows activity clearly after the stale
                # registry entry, the session was resumed since the crash and
                # is no longer waiting to be reopened.
                resumed_since = (
                    session.last_active is not None
                    and session.last_active > updated_at + 60
                )
                if not resumed_since:
                    session.status = STATUS_CRASHED


BACKENDS: dict[str, Backend] = {b.name: b for b in [ClaudeBackend()]}


# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------


def _parse_lines(lines: list[str]) -> list[dict]:
    parsed = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if isinstance(obj, dict):
            parsed.append(obj)
    return parsed


def _parse_ts(value) -> float | None:
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _message_text(obj: dict) -> str:
    content = (obj.get("message") or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                return block.get("text", "")
    return ""


def _clean_text(text: str) -> str:
    text = re.sub(r"<[^>]{1,80}>", " ", text or "")  # strip inline tags
    return " ".join(text.split())


def _boot_time() -> float | None:
    try:
        with open("/proc/uptime") as fh:
            return time.time() - float(fh.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None  # non-Linux: degrade to pid-liveness only


def _pid_is_claude(pid) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            return b"claude" in fh.read().lower()
    except OSError:
        # Either the pid is gone, or /proc is unavailable (non-Linux) — in
        # the latter case fall back to a plain liveness check.
        if not os.path.isdir("/proc"):
            try:
                os.kill(pid, 0)
                return True
            except ProcessLookupError:
                return False
            except PermissionError:
                return True
        return False


def _relative_time(ts: float | None) -> str:
    if ts is None:
        return "?"
    delta = time.time() - ts
    if delta < 0:
        delta = 0
    if delta < 60:
        return "just now"
    if delta < 3600:
        return f"{int(delta // 60)}m ago"
    if delta < 48 * 3600:
        return f"{int(delta // 3600)}h ago"
    if delta < 14 * 86400:
        return f"{int(delta // 86400)}d ago"
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")


def _short_path(path: str, width: int) -> str:
    home = str(Path.home())
    if path == home:
        path = "~"
    elif path.startswith(home + os.sep):
        path = "~" + path[len(home):]
    if len(path) <= width:
        return path
    parts = path.split(os.sep)
    while len(parts) > 2 and len(os.sep.join(parts)) > width - 2:
        del parts[1 if parts[0] in ("~", "") else 0]
        result = parts[0] + os.sep + "…" + os.sep + os.sep.join(parts[1:])
        if len(result) <= width:
            return result
    return path[: width - 1] + "…"


def _truncate(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"


def _make_snippet(text: str, terms: list[str], width: int = 70) -> str:
    """Window of `text` centred on its first matching term."""
    text = _clean_text(text)
    low = text.lower()
    found = [(low.find(t), t) for t in terms]
    found = [(idx, t) for idx, t in found if idx >= 0]
    if not found:
        return _truncate(text, width)
    idx, term = min(found)
    start = max(0, idx - max(0, (width - len(term)) // 2))
    end = min(len(text), start + width)
    prefix = "…" if start > 0 else ""
    suffix = "…" if end < len(text) else ""
    return prefix + text[start:end] + suffix


# --------------------------------------------------------------------------
# Search
# --------------------------------------------------------------------------

# Relevance weights. Coverage dominates: a session that mentions every term
# beats one that mentions the rarest term a hundred times. Recency only
# nudges — it used to be the sole ordering, which buried the best hits.
W_COVERAGE = 100.0     # query terms present anywhere in the session
W_CONVERSATION = 30.0  # ... and present in conversation, not just tool output
W_PHRASE = 45.0        # the whole query appears verbatim
W_PROXIMITY = 30.0     # best single message's own term coverage
W_TITLE = 20.0         # terms in the session title
W_USER_FREQ = 20.0     # repetition in my own prompts
W_ASSIST_FREQ = 10.0   # repetition in replies
W_RAW_FREQ = 5.0       # repetition in tool output (--everything)
W_RECENCY = 10.0       # decays with a 45-day half-life
FREQ_SATURATION = 25   # match count at which a frequency term maxes out

TERM_RE = re.compile(r'"([^"]*)"|(\S+)')


def parse_query(query: str) -> list[str]:
    """Split a query into terms; "quoted text" stays a single term."""
    terms: list[str] = []
    for quoted, bare in TERM_RE.findall(query):
        term = (quoted or bare).strip().lower()
        if term and term not in terms:
            terms.append(term)
    return terms


def query_phrase(query: str) -> str:
    """The whole query as one contiguous phrase, or "" if that's meaningless."""
    if '"' in query:
        return ""  # explicit quoting already expresses the phrase
    phrase = " ".join(query.lower().split())
    return phrase if " " in phrase else ""


def _grep_hits(terms: list[str], paths: list[str]) -> dict[str, set[str]]:
    """Per-term set of transcripts containing it anywhere (a cheap prefilter).

    Doubles as document frequency for the IDF weights. Falls back to "every
    term is in every file" when grep is unavailable, which degrades to a full
    scan with uniform term weights.
    """
    hits: dict[str, set[str]] = {}
    for term in terms:
        matched: set[str] = set()
        for chunk in (paths[i:i + 500] for i in range(0, len(paths), 500)):
            try:
                result = subprocess.run(
                    ["grep", "-l", "-i", "-F", "--", term, *chunk],
                    capture_output=True, text=True,
                )
            except OSError:
                return {t: set(paths) for t in terms}  # no grep available
            if result.returncode > 1:
                return {t: set(paths) for t in terms}  # grep error
            matched.update(p for p in result.stdout.splitlines() if p)
        hits[term] = matched
    return hits


def _scan_transcript(path: str, backend: Backend, terms: list[str],
                     phrase: str, everything: bool) -> dict | None:
    """Match statistics for one transcript, or None if it's unreadable."""
    stats = {
        "matched": set(),      # terms found in conversation text
        "raw_matched": set(),  # terms found only in tool output
        "user": 0,            # matching messages I wrote
        "assistant": 0,       # matching replies
        "raw": 0,             # matching tool-output lines
        "phrase": False,
        "best_hits": (),      # terms of the most on-point single message
        "snippet_text": "",
    }
    best_rank = -1.0
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                low = line.lower()
                present = [t for t in terms if t in low]
                if not present:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    obj = None
                text = backend.searchable_text(obj) if isinstance(obj, dict) else None
                if not text:
                    if everything:
                        stats["raw"] += 1
                        stats["raw_matched"].update(present)
                    continue
                low_text = text.lower()
                hits = [t for t in present if t in low_text]
                if not hits:
                    if everything:
                        stats["raw"] += 1
                        stats["raw_matched"].update(present)
                    continue
                stats["matched"].update(hits)
                kind = obj.get("type")
                if kind in ("ai-title", "last-prompt"):
                    continue  # metadata mirroring the title/prompt: no double count
                is_user = kind == "user"
                if is_user:
                    stats["user"] += 1
                else:
                    stats["assistant"] += 1
                line_phrase = bool(phrase) and phrase in low_text
                stats["phrase"] = stats["phrase"] or line_phrase
                rank = len(hits) + (0.5 if line_phrase else 0.0) + (0.2 if is_user else 0.0)
                if rank > best_rank:
                    best_rank = rank
                    stats["best_hits"] = tuple(hits)
                    stats["snippet_text"] = text
    except OSError:
        return None
    return stats


def _recency_bonus(last_active: float | None) -> float:
    if not last_active:
        return 0.0
    age_days = max(0.0, (time.time() - last_active) / 86400)
    return W_RECENCY * 0.5 ** (age_days / 45.0)


def _score(stats: dict, session: Session, terms: list[str],
           idf: dict[str, float]) -> float:
    total = sum(idf.values()) or 1.0

    def weight(found) -> float:
        return sum(idf[t] for t in found if t in idf) / total

    def freq(n: int) -> float:
        return min(1.0, math.log1p(n) / math.log1p(FREQ_SATURATION))

    title = (session.title or "").lower()
    return (
        W_COVERAGE * weight(stats["matched"] | stats["raw_matched"])
        + W_CONVERSATION * weight(stats["matched"])
        + W_PHRASE * (1.0 if stats["phrase"] else 0.0)
        + W_PROXIMITY * weight(stats["best_hits"])
        + W_TITLE * weight([t for t in terms if t in title])
        + W_USER_FREQ * freq(stats["user"])
        + W_ASSIST_FREQ * freq(stats["assistant"])
        + W_RAW_FREQ * freq(stats["raw"])
        + _recency_bonus(session.last_active)
    )


def run_search(sessions: list[Session], terms: list[str], phrase: str,
               everything: bool, recent_first: bool = False,
               ) -> tuple[list[Session], bool]:
    """Rank sessions by how well they match `terms`.

    Sessions matching every term win; only if none does are partial matches
    shown, and the returned flag says so. Returns (results, relaxed).
    """
    by_path = {s.transcript_path: s for s in sessions if s.transcript_path}
    if not by_path or not terms:
        return [], False
    paths = list(by_path)
    hits = _grep_hits(terms, paths)
    total_docs = len(paths)
    idf = {
        t: math.log(1 + total_docs / (1 + len(hits.get(t, ()))))
        for t in terms
    }
    strict = set.intersection(*(hits[t] for t in terms))

    scanned: dict[str, dict] = {}

    def scan(candidates) -> list[Session]:
        found = []
        for path in candidates:
            session = by_path[path]
            stats = scanned.get(path)
            if stats is None:
                stats = _scan_transcript(
                    path, BACKENDS[session.backend], terms, phrase, everything
                )
                if stats is None:
                    continue
                scanned[path] = stats
            matched = stats["matched"] | stats["raw_matched"]
            if not matched:
                continue
            session.match_count = stats["user"] + stats["assistant"] + stats["raw"]
            session.term_hits = len(matched)
            session.term_total = len(terms)
            session.score = _score(stats, session, terms, idf)
            session.snippet = (
                _make_snippet(stats["snippet_text"], terms)
                if stats["snippet_text"] else "(match in tool output)"
            )
            found.append(session)
        return found

    results = [s for s in scan(strict) if s.term_hits == len(terms)]
    relaxed = False
    if not results:
        results = scan(strict | set().union(*hits.values()))
        relaxed = len(terms) > 1 and bool(results)

    if recent_first:
        results.sort(key=lambda s: s.last_active or 0, reverse=True)
    else:
        results.sort(key=lambda s: (s.score, s.last_active or 0), reverse=True)
    return results, relaxed


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------


def gather(args) -> list[Session]:
    sessions: list[Session] = []
    for name, backend in BACKENDS.items():
        if args.backend and name != args.backend:
            continue
        sessions.extend(backend.discover())

    if not args.json:
        sessions = [s for s in sessions if s.has_messages]
    if args.here:
        base = os.getcwd()
        sessions = [
            s for s in sessions
            if s.cwd == base or s.cwd.startswith(base + os.sep)
        ]
    if args.project:
        base = str(Path(args.project).expanduser().resolve())
        sessions = [
            s for s in sessions
            if s.cwd == base or s.cwd.startswith(base + os.sep)
        ]
    sessions.sort(key=lambda s: s.last_active or 0, reverse=True)
    return sessions


def render_rows(sessions: list[Session], color: bool, show_matches: bool = False) -> list[str]:
    term_width = shutil.get_terminal_size((120, 24)).columns
    project_w = 24
    id_w = 8
    time_w = 11
    matches_w = (
        max(7, *(len(s.match_label) for s in sessions)) if show_matches and sessions
        else 7 if show_matches else 0
    )
    show_backend = len({s.backend for s in sessions}) > 1
    backend_w = 8 if show_backend else 0
    fixed = (2 + time_w + 2 + project_w + 2 + id_w + 2
             + (backend_w + 2 if show_backend else 0)
             + (matches_w + 2 if show_matches else 0))
    title_w = max(20, min(term_width - fixed, 60))

    def paint(text, code):
        return f"{code}{text}{NC}" if color else text

    header = (
        "   "
        + "LAST ACTIVE".ljust(time_w + 2)
        + ("BACKEND".ljust(backend_w + 2) if show_backend else "")
        + "PROJECT".ljust(project_w + 2)
        + "TITLE".ljust(title_w + 2)
        + ("MATCHES".ljust(matches_w + 2) if show_matches else "")
        + "ID"
    )
    rows = [paint(header, DIM)]
    for s in sessions:
        if s.status == STATUS_RUNNING:
            marker = paint("●", GREEN)
        elif s.status == STATUS_CRASHED:
            marker = paint("✗", YELLOW)
        else:
            marker = " "
        line = (
            f" {marker} "
            + _relative_time(s.last_active).ljust(time_w + 2)
            + ((s.backend.ljust(backend_w + 2)) if show_backend else "")
            + _short_path(s.cwd or "?", project_w).ljust(project_w + 2)
            + _truncate(s.title or "(no title)", title_w).ljust(title_w + 2)
            + (s.match_label.ljust(matches_w + 2) if show_matches else "")
            + s.session_id[:id_w]
        )
        if s.status == STATUS_CRASHED and color:
            line = f"{YELLOW}{line}{NC}"
        rows.append(line)
    return rows


def render_snippet(session: Session, terms: list[str], color: bool, width: int) -> str:
    snippet = _truncate(session.snippet, width)
    if not color or not terms:
        return snippet
    # highlight every matched term inside the dimmed snippet; longest first so
    # a term that contains another still highlights as one run
    pattern = re.compile(
        "|".join(re.escape(t) for t in sorted(terms, key=len, reverse=True)),
        re.IGNORECASE,
    )
    lit = pattern.sub(lambda m: f"{NC}{YELLOW}{m.group(0)}{NC}{DIM}", snippet)
    return f"{DIM}{lit}{NC}"


def cmd_list(args):
    sessions = gather(args)
    if args.json:
        print(json.dumps([_session_json(s) for s in sessions[: args.limit]], indent=2))
        return 0
    if not sessions:
        print("no sessions found")
        return 0
    color = sys.stdout.isatty()
    for row in render_rows(sessions[: args.limit], color):
        print(row)
    crashed = [s for s in sessions if s.status == STATUS_CRASHED]
    if crashed and not args.crashed_only:
        n = len(crashed)
        plural = "s were" if n > 1 else " was"
        hint = (
            f"\n{n} session{plural} open when the machine last went down"
            f" — 'ai-sessions crashed' to review"
        )
        print(f"{YELLOW}{hint}{NC}" if color else hint)
    return 0


def cmd_crashed(args):
    args.crashed_only = True
    sessions = [s for s in gather(args) if s.status == STATUS_CRASHED]
    if args.json:
        print(json.dumps([_session_json(s) for s in sessions], indent=2))
        return 0
    if not sessions:
        print("no sessions were left open — nothing to recover")
        return 0
    color = sys.stdout.isatty()
    for row in render_rows(sessions, color):
        print(row)
    print("\nresume one with: ai-sessions pick")
    return 0


PREVIEW_MAX_BYTES = 2 * 1024 * 1024


def cmd_preview(path: str) -> int:
    """Render one transcript as a readable conversation (fzf preview pane)."""
    if not path or path == "-" or not os.path.isfile(path):
        print("(no transcript on disk)")
        return 0
    backend = BACKENDS["claude"]
    header_done = False
    try:
        size = os.path.getsize(path)
        with open(path, errors="replace") as fh:
            if size > PREVIEW_MAX_BYTES:
                fh.seek(size - PREVIEW_MAX_BYTES)
                fh.readline()  # drop partial line
                print(f"{DIM}… earlier conversation truncated …{NC}\n")
            for line in fh:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(obj, dict):
                    continue
                kind = obj.get("type")
                if kind not in ("user", "assistant"):
                    continue
                text = backend.searchable_text(obj)
                if not text or not text.strip():
                    continue
                if not header_done:
                    cwd = obj.get("cwd", "")
                    ts = obj.get("timestamp", "")[:16].replace("T", " ")
                    print(f"{DIM}{_short_path(cwd, 60)}   started {ts}{NC}\n")
                    header_done = True
                text = text.strip()
                if kind == "user":
                    print(f"{GREEN}{BOLD}❯ {text}{NC}")
                else:
                    print(text)
                print()
    except OSError:
        print("(transcript unreadable)")
    return 0


def choose_and_resume(sessions: list[Session], rows: list[str],
                      reload_argv: list[str] | None = None,
                      query: str = "") -> int:
    chosen = (_fzf_choose(sessions, rows, reload_argv, query)
              or _prompt_choose(sessions, rows))
    if chosen is None:
        return 1
    backend = BACKENDS[chosen.backend]
    cwd = chosen.cwd if chosen.cwd and os.path.isdir(chosen.cwd) else str(Path.home())
    os.chdir(cwd)
    argv = backend.resume_argv(chosen)
    try:
        os.execvp(argv[0], argv)
    except OSError as exc:
        print(f"error: could not run {argv[0]}: {exc}", file=sys.stderr)
        return 1


def cmd_pick(args):
    sessions = gather(args)
    if args.crashed_only:
        sessions = [s for s in sessions if s.status == STATUS_CRASHED]
    sessions = sessions[: args.limit]
    if not sessions:
        print("no sessions found", file=sys.stderr)
        return 1
    rows = render_rows(sessions, color=True)[1:]  # skip header
    return choose_and_resume(sessions, rows, _scope_argv(args, window=True))


def _scope_argv(args, window: bool = False) -> list[str]:
    """The scope flags to replay in the picker's live search, so that typing
    searches exactly the sessions the picker was populated from.

    `window` confines the search to the -n rows on screen — right for the
    plain picker, which offers a recent window. `search` populates from the
    whole scoped set instead, so it leaves this off and stays broad.
    """
    argv = ["-n", str(args.limit)]
    if args.here:
        argv.append("--here")
    if args.project:
        argv += ["--project", args.project]
    if args.backend:
        argv += ["--backend", args.backend]
    if args.everything:
        argv.append("--everything")
    if args.recent:
        argv.append("--recent")
    if getattr(args, "crashed_only", False):
        argv.append("--crashed-only")
    if window:
        argv.append("--window")
    return argv


def cmd_rows(argv: list[str]) -> int:
    """One page of picker feed: the recent list, or ranked hits for a query.

    Internal — fzf runs this on every keystroke (see _fzf_choose).
    """
    parser = argparse.ArgumentParser(prog="ai-sessions _rows", add_help=False)
    _add_scope_args(parser)
    parser.add_argument("--crashed-only", action="store_true")
    parser.add_argument("--window", action="store_true")
    parser.add_argument("query", nargs="*")
    args = parser.parse_args(argv)
    sessions = gather(args)
    if args.crashed_only:
        sessions = [s for s in sessions if s.status == STATUS_CRASHED]
    if args.window:
        # the picker holds this many rows, so this is the set on screen —
        # search it and nothing else, or typing would surface sessions the
        # list never offered. `-n` widens what is listed and searched at once.
        sessions = sessions[: args.limit]

    query = " ".join(args.query).strip()
    terms = parse_query(query)
    if len(query) < 2 or not terms:
        # a single character matches nearly everything; not worth a scan
        print(_feed(sessions, render_rows(sessions, color=True)[1:]))
        return 0

    results, _ = run_search(
        sessions, terms, query_phrase(query), args.everything, args.recent
    )
    # content search never looks at the project path, but filtering the
    # picker by project used to work — keep it reachable by appending
    # path-only matches after the ranked hits
    seen = {s.session_id for s in results}
    extra = [
        s for s in sessions
        if s.session_id not in seen
        and all(t in (s.cwd or "").lower() for t in terms)
    ]
    for s in extra:
        s.match_note = "path"
        s.snippet = "(matches the project path)"
    results = (results + extra)[: args.limit]

    rows = render_rows(results, color=True, show_matches=True)[1:]
    rows = [
        row + "  " + render_snippet(s, terms, color=True, width=60)
        for row, s in zip(rows, results)
    ]
    print(_feed(results, rows))
    return 0


def cmd_search(args):
    sessions = gather(args)
    terms = parse_query(args.query)
    if not terms:
        print("search requires a query", file=sys.stderr)
        return 1
    results, relaxed = run_search(
        sessions, terms, query_phrase(args.query), args.everything, args.recent
    )
    if args.json:
        out = []
        for s in results[: args.limit]:
            record = _session_json(s)
            record["match_count"] = s.match_count
            record["terms_matched"] = s.term_hits
            record["terms_total"] = s.term_total
            record["score"] = round(s.score, 2)
            record["snippet"] = s.snippet
            out.append(record)
        print(json.dumps(out, indent=2))
        return 0
    if not results:
        print(f"no sessions match {args.query!r}"
              + ("" if args.everything else " — try --everything to include tool output")
)
        return 1
    results = results[: args.limit]
    color = sys.stdout.isatty()
    note = ""
    if relaxed:
        note = (f"no session mentions all {len(terms)} terms"
                " — showing the best partial matches")

    if color:
        rows = render_rows(results, color=True, show_matches=True)[1:]
        rows = [
            row + "  " + render_snippet(s, terms, color=True, width=60)
            for row, s in zip(rows, results)
        ]
        if note:
            print(f"{YELLOW}{note}{NC}")
        # seed the picker with this query so editing it re-searches
        return choose_and_resume(results, rows, _scope_argv(args), args.query)

    if note:
        print(note)
    rows = render_rows(results, color, show_matches=True)
    print(rows[0])
    for row, s in zip(rows[1:], results):
        print(row)
        print("     " + render_snippet(s, terms, color, width=100))
    return 0


def _feed(sessions, rows) -> str:
    """fzf input: the fields needed to resume or preview, then the rendered
    row — the only visible part. Rows never contain tabs (titles go through
    _clean_text), so tab is a safe delimiter.
    """
    return "\n".join(
        f"{s.session_id}\t{s.backend}\t{s.cwd or ''}\t"
        f"{s.transcript_path or '-'}\t{row}"
        for s, row in zip(sessions, rows)
    )


def _fzf_choose(sessions, rows, reload_argv=None, query="") -> Session | None:
    if not shutil.which("fzf"):
        return None
    script = shlex.quote(os.path.abspath(sys.argv[0]))
    argv = [
        "fzf", "--ansi", "--delimiter=\t", "--with-nth=5..",
        "--height=~50%", "--reverse", "--no-sort",
        "--prompt=session> ",
        "--preview", f"{script} _preview {{4}}",
        "--preview-window", "right,60%,wrap,hidden",
        "--bind", "ctrl-/:toggle-preview",
    ]
    header = "ctrl-/ preview · enter resume · esc quit"
    if reload_argv is not None:
        # Typing has to search conversation content, not just the visible
        # row. fzf can't match fields it doesn't display, so hand every
        # keystroke to our own ranked search instead of filtering locally.
        # fzf kills a running reload when the query changes again, so the
        # leading sleep lets a superseded query die before it costs a scan.
        flags = " ".join(shlex.quote(a) for a in reload_argv)
        argv += [
            "--disabled",
            "--bind",
            f"change:reload:sleep 0.15; {script} _rows {flags} -- {{q}} || true",
            "--query", query,
        ]
        scope = (f"these {len(sessions)} sessions" if "--window" in reload_argv
                 else "every session")
        header = f"type to search {scope} · " + header
    argv += ["--header", header]
    try:
        result = subprocess.run(
            argv, input=_feed(sessions, rows), capture_output=True, text=True,
        )
    except OSError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        sys.exit(0)  # cancelled
    # the reloaded list is built by a child process, so the chosen line
    # carries everything needed to resume rather than an index into `sessions`
    fields = result.stdout.rstrip("\n").split("\t")
    if len(fields) < 4 or fields[1] not in BACKENDS:
        return None
    return Session(
        backend=fields[1], session_id=fields[0], cwd=fields[2],
        title="", created=None, last_active=None, transcript_path=fields[3],
    )


def _prompt_choose(sessions, rows) -> Session | None:
    if not sys.stdout.isatty():
        rows = [re.sub(r"\033\[[0-9;]*m", "", row) for row in rows]
    for i, row in enumerate(rows):
        print(f"{i:3}  {row}")
    try:
        raw = input("session number> ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if not raw.isdigit() or int(raw) >= len(sessions):
        print("invalid selection", file=sys.stderr)
        return None
    return sessions[int(raw)]


def _session_json(s: Session) -> dict:
    def iso(ts):
        if ts is None:
            return None
        return datetime.fromtimestamp(ts, tz=timezone.utc).isoformat()

    return {
        "backend": s.backend,
        "session_id": s.session_id,
        "cwd": s.cwd,
        "title": s.title,
        "created": iso(s.created),
        "last_active": iso(s.last_active),
        "status": s.status,
    }


def _add_scope_args(parser):
    """Flags that select and shape the session set, shared by the user-facing
    parser and the picker's internal _rows helper."""
    parser.add_argument("-n", "--limit", type=int, default=20,
                        help="max rows to show (default: 20)")
    parser.add_argument("--here", action="store_true",
                        help="only sessions under the current directory")
    parser.add_argument("--project", metavar="PATH",
                        help="only sessions under PATH")
    parser.add_argument("--backend", choices=sorted(BACKENDS),
                        help="only this backend")
    parser.add_argument("--json", action="store_true",
                        help="machine-readable output")
    parser.add_argument("--everything", action="store_true",
                        help="search: also match tool output "
                             "(command results, file contents)")
    parser.add_argument("--recent", action="store_true",
                        help="search: order hits by last activity instead of "
                             "relevance")


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    if argv and argv[0] == "_preview":  # fzf preview helper, not user-facing
        return cmd_preview(argv[1] if len(argv) > 1 else "")
    if argv and argv[0] == "_rows":  # fzf reload helper, not user-facing
        return cmd_rows(argv[1:])
    parser = argparse.ArgumentParser(
        prog="ai-sessions",
        description="Overview and recovery of AI CLI coding sessions.",
    )
    _add_scope_args(parser)
    parser.add_argument("command", nargs="?", default=None,
                        choices=["list", "pick", "crashed", "search"],
                        help="pick (fzf + resume; default on a terminal), "
                             "list (table; default when piped), "
                             "crashed (sessions open at last shutdown), "
                             "search <query> (full-text search + resume)")
    parser.add_argument("query", nargs="*",
                        help="terms to search for (search command only); every "
                             "term must appear, a quoted group matches as a phrase")
    args = parser.parse_args(argv)
    # a shell-quoted group arrives as one argv element with spaces in it —
    # re-quote it so parse_query keeps it together as a phrase
    args.query = " ".join(
        f'"{part}"' if any(c.isspace() for c in part) else part
        for part in args.query
    )
    if args.command is None:
        interactive = sys.stdout.isatty() and not args.json
        args.command = "pick" if interactive else "list"
    if args.command == "search" and not args.query:
        parser.error("search requires a query, e.g.: ai-sessions search \"flaky test\"")
    if args.command != "search" and args.query:
        parser.error(f"unexpected argument {args.query!r} "
                     f"(did you mean: ai-sessions search {args.query}?)")
    args.crashed_only = args.command == "crashed"

    if args.command == "pick":
        return cmd_pick(args)
    if args.command == "crashed":
        return cmd_crashed(args)
    if args.command == "search":
        return cmd_search(args)
    return cmd_list(args)


if __name__ == "__main__":
    import signal
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # die quietly on | head
    sys.exit(main())
