#!/usr/bin/env python3
"""ai-sessions — overview and recovery of AI CLI coding sessions.

Lists recent sessions across all projects with titles and last-activity
times, flags sessions that were still open when the machine went down,
and resumes a chosen session via fzf.

Backends are pluggable; currently implemented: claude (Claude Code).
"""

import argparse
try:
    import fcntl
except ImportError:  # not POSIX: the index runs unlocked
    fcntl = None
import hashlib
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import textwrap
import threading
import time
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

UUID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
)

STATUS_RUNNING = "running"
STATUS_CRASHED = "crashed"  # was open when the machine/process died uncleanly
STATUS_CLOSED = "closed"

HEAD_BYTES = 8 * 1024
TAIL_BYTES = 64 * 1024
TAIL_BYTES_MAX = 1024 * 1024

# A session left open longer ago than this is history, not something to
# recover: it stops being flagged as crashed.
CRASH_MAX_AGE = 14 * 86400

# Headless `claude -p` runs (scripts, agents drafting replies). Hidden
# unless --all, since nobody resumes them by hand.
HEADLESS_ENTRYPOINTS = ("sdk-cli",)

GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
DIM = "\033[2m"
BOLD = "\033[1m"
NC = "\033[0m"


@dataclass
class Session:
    backend: str
    session_id: str
    cwd: str
    title: str
    created: float | None  # epoch seconds
    last_active: float | None
    status: str = STATUS_CLOSED
    has_messages: bool = True
    transcript_path: str = ""
    entrypoint: str = ""  # how the session was started: cli, sdk-cli, ...
    subagent_paths: list[str] = field(default_factory=list)
    match_count: int = 0
    snippet: str = ""
    score: float = 0.0
    term_hits: int = 0   # query terms this session matched
    term_total: int = 0  # query terms searched for
    match_note: str = ""  # label instead of a count, for a non-content hit

    @property
    def match_label(self) -> str:
        if self.match_note:
            return self.match_note
        if self.term_total > 1:
            return f"{self.term_hits}/{self.term_total}·{self.match_count}"
        return str(self.match_count)


# --------------------------------------------------------------------------
# Backend framework
# --------------------------------------------------------------------------


class Backend:
    """A source of AI CLI sessions. Subclass per tool."""

    name = "?"

    def discover(self) -> list[Session]:
        raise NotImplementedError

    def resume_argv(self, session: Session) -> list[str]:
        raise NotImplementedError

    def conversation_line(self, obj: dict) -> tuple[str, str] | None:
        """(kind, text) for one transcript line that is conversation, or
        None for metadata, tool traffic, ... Kind is "user", "assistant",
        "title" or "prompt" (the last prompt, mirrored as metadata)."""
        raise NotImplementedError

    def searchable_text(self, obj: dict) -> str | None:
        line = self.conversation_line(obj)
        return line[1] if line else None


# --------------------------------------------------------------------------
# Claude Code backend
# --------------------------------------------------------------------------


class ClaudeBackend(Backend):
    """Reads Claude Code session transcripts and its live-process registry.

    Data layout (Claude Code >= 2.x):
      ~/.claude/projects/<dir>/<uuid>.jsonl   one transcript per session
      ~/.claude/projects/<dir>/<uuid>/subagents/*.jsonl  its subagents
      ~/.claude/sessions/<pid>.json           registry of running sessions

    Transcript notes:
      - message lines carry an ISO `timestamp` and the session `cwd`
      - metadata lines (`ai-title`, `agent-name`, `last-prompt`) carry no
        timestamp and are rewritten in place long after the last message,
        so file mtime overstates the last interaction — the last line
        *with* a timestamp is the real last activity
      - subagent transcripts live in subdirectories and are excluded by
        only globbing depth-1 UUID-named files

    Registry notes: Claude Code deletes the entries of dead processes
    whenever a session starts, so a crashed session's entry only survives
    until the next `claude` (including the resume of another crashed
    session). It is good for "running", not for "crashed"; that comes from
    our own ledger, written by the SessionStart/SessionEnd hook (`_hook`).
    """

    name = "claude"

    def __init__(self):
        self.claude_dir = Path(
            os.environ.get("CLAUDE_DIR", "~/.claude")
        ).expanduser()

    @property
    def ledger_dir(self) -> Path:
        return _state_dir() / "claude" / "open"

    def resume_argv(self, session: Session) -> list[str]:
        return ["claude", "--resume", session.session_id]

    def discover(self) -> list[Session]:
        sessions = []
        for transcript in self._transcripts():
            try:
                session = self._parse_transcript(transcript)
            except OSError:
                continue
            if session:
                sessions.append(session)
        self._apply_status(sessions)
        return sessions

    def _transcripts(self):
        projects = self.claude_dir / "projects"
        if not projects.is_dir():
            return
        try:
            project_dirs = sorted(projects.iterdir())
        except OSError:
            return
        for project_dir in project_dirs:
            try:
                entries = sorted(project_dir.iterdir())
            except OSError:
                continue  # e.g. root-owned dir from a devcontainer
            for entry in entries:
                if entry.suffix == ".jsonl" and UUID_RE.match(entry.stem):
                    yield entry

    def _parse_transcript(self, path: Path) -> Session | None:
        session_id = path.stem
        head_lines = self._read_head(path)
        tail_lines = self._read_tail(path)

        created = None
        cwd = ""
        entrypoint = ""
        first_user_text = ""
        meta = {}  # last-seen ai-title / agent-name / last-prompt
        has_messages = False

        for obj in head_lines:
            ts = _parse_ts(obj.get("timestamp"))
            if created is None and ts is not None:
                created = ts
            if not cwd and isinstance(obj.get("cwd"), str):
                cwd = obj["cwd"]
            if not entrypoint and isinstance(obj.get("entrypoint"), str):
                entrypoint = obj["entrypoint"]
            if obj.get("type") in ("user", "assistant"):
                has_messages = True
                if not first_user_text and obj.get("type") == "user":
                    first_user_text = _message_text(obj)
            self._collect_meta(obj, meta)

        last_active = None
        for obj in reversed(tail_lines):
            ts = _parse_ts(obj.get("timestamp"))
            if ts is not None:
                last_active = ts
                break
        for obj in tail_lines:
            self._collect_meta(obj, meta)
            if obj.get("type") in ("user", "assistant"):
                has_messages = True
                if not cwd and isinstance(obj.get("cwd"), str):
                    cwd = obj["cwd"]
            if not entrypoint and isinstance(obj.get("entrypoint"), str):
                entrypoint = obj["entrypoint"]

        if last_active is None:
            # Degenerate transcript (e.g. a title line and nothing else).
            last_active = path.stat().st_mtime

        title = (
            meta.get("ai-title")
            or meta.get("agent-name")
            or meta.get("last-prompt")
            or first_user_text
        )
        subagent_dir = path.with_suffix("") / "subagents"
        try:
            subagents = sorted(
                str(p) for p in subagent_dir.iterdir() if p.suffix == ".jsonl"
            )
        except OSError:
            subagents = []
        return Session(
            backend=self.name,
            session_id=session_id,
            cwd=cwd,
            title=_clean_text(title),
            created=created,
            last_active=last_active,
            has_messages=has_messages,
            transcript_path=str(path),
            entrypoint=entrypoint,
            subagent_paths=subagents,
        )

    def conversation_line(self, obj: dict) -> tuple[str, str] | None:
        kind = obj.get("type")
        if kind == "ai-title":
            text = obj.get("aiTitle")
            return ("title", text) if isinstance(text, str) and text else None
        if kind == "last-prompt":
            text = obj.get("lastPrompt")
            return ("prompt", text) if isinstance(text, str) and text else None
        if kind not in ("user", "assistant"):
            return None
        content = (obj.get("message") or {}).get("content")
        if isinstance(content, str):
            return (kind, content) if content else None
        if isinstance(content, list):
            # Tool results come back as user-role lines with tool_result
            # blocks — that's tool output, not conversation.
            texts = [
                block.get("text", "")
                for block in content
                if isinstance(block, dict) and block.get("type") == "text"
            ]
            text = "\n".join(t for t in texts if isinstance(t, str) and t)
            return (kind, text) if text else None
        return None

    @staticmethod
    def _collect_meta(obj: dict, meta: dict):
        kind = obj.get("type")
        if kind == "ai-title" and obj.get("aiTitle"):
            meta["ai-title"] = obj["aiTitle"]
        elif kind == "agent-name" and obj.get("agentName"):
            meta["agent-name"] = obj["agentName"]
        elif kind == "last-prompt" and obj.get("lastPrompt"):
            meta["last-prompt"] = obj["lastPrompt"]

    @staticmethod
    def _read_head(path: Path) -> list[dict]:
        with open(path, "rb") as fh:
            data = fh.read(HEAD_BYTES)
            truncated = len(data) == HEAD_BYTES
        lines = data.decode("utf-8", errors="replace").split("\n")
        if truncated:
            lines = lines[:-1]  # drop partial final line
        return _parse_lines(lines)

    @staticmethod
    def _read_tail(path: Path) -> list[dict]:
        size = path.stat().st_size
        window = TAIL_BYTES
        while True:
            with open(path, "rb") as fh:
                fh.seek(max(0, size - window))
                data = fh.read()
            lines = data.decode("utf-8", errors="replace").split("\n")
            if size > window:
                lines = lines[1:]  # drop partial first line
            parsed = _parse_lines(lines)
            if any(_parse_ts(o.get("timestamp")) for o in parsed):
                return parsed
            if window >= size or window >= TAIL_BYTES_MAX:
                return parsed
            window = min(window * 4, TAIL_BYTES_MAX)

    # -- running / crashed ------------------------------------------------

    def _registry_entries(self) -> list[dict]:
        """Claude Code's own registry, normalised. Proves a session is
        running; a dead entry is a crash only until the next `claude`
        start sweeps it away."""
        registry_dir = self.claude_dir / "sessions"
        entries = []
        boot_time = _boot_time()
        for entry_path in sorted(registry_dir.glob("*.json")):
            try:
                entry = json.loads(entry_path.read_text())
            except (OSError, ValueError):
                continue
            if not isinstance(entry, dict) or not entry.get("sessionId"):
                continue
            updated_at = (entry.get("updatedAt") or 0) / 1000.0
            entries.append({
                "session_id": entry["sessionId"],
                "alive": _pid_alive(
                    entry.get("pid"), entry.get("procStart"),
                    since=updated_at, boot_time=boot_time,
                ),
                "cwd": entry.get("cwd", ""),
                "name": entry.get("name", ""),
                "started": (entry.get("startedAt") or 0) / 1000.0 or None,
                "entrypoint": entry.get("entrypoint", ""),
            })
        return entries

    def _ledger_entries(self) -> list[dict]:
        """Our own record of open sessions, kept by the hook: written at
        SessionStart, removed at SessionEnd. An entry whose process is gone
        is a session that never exited cleanly."""
        entries = []
        try:
            paths = sorted(self.ledger_dir.glob("*.json"))
        except OSError:
            return entries
        for path in paths:
            try:
                entry = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if not isinstance(entry, dict) or not entry.get("session_id"):
                continue
            entries.append({
                "session_id": entry["session_id"],
                "alive": _pid_alive(entry.get("pid"), entry.get("proc_start")),
                "cwd": entry.get("cwd", ""),
                "name": "",
                "started": entry.get("started"),
                "entrypoint": "",
            })
        return entries

    def _apply_status(self, sessions: list[Session]):
        """Mark sessions running (a live process holds them) or crashed (a
        record says they were open, and their process is gone)."""
        by_id = {s.session_id: s for s in sessions}
        entries = self._registry_entries() + self._ledger_entries()
        running = {e["session_id"]: e for e in entries if e["alive"]}
        for session_id, entry in running.items():
            session = by_id.get(session_id)
            if session is None:
                # A live session with no transcript yet (nothing said so
                # far) is still worth showing as running.
                session = Session(
                    backend=self.name,
                    session_id=session_id,
                    cwd=entry["cwd"],
                    title=_clean_text(entry["name"]),
                    created=entry["started"],
                    last_active=entry["started"],
                    entrypoint=entry["entrypoint"],
                )
                sessions.append(session)
                by_id[session_id] = session
            session.status = STATUS_RUNNING
        cutoff = time.time() - CRASH_MAX_AGE
        for entry in entries:
            session = by_id.get(entry["session_id"])
            # no transcript means nothing to resume; too old means history
            if (session is None or session.status == STATUS_RUNNING
                    or (session.last_active or 0) < cutoff):
                continue
            session.status = STATUS_CRASHED

    def record_hook(self, event: dict):
        """Keep the ledger from a SessionStart/SessionEnd hook event."""
        session_id = str(event.get("session_id") or "")
        if not UUID_RE.match(session_id):
            return
        path = self.ledger_dir / f"{session_id}.json"
        claude = _claude_ancestor()
        if claude is None:
            return  # not run by claude (or no /proc): nothing to record
        pid, proc_start = claude
        name = event.get("hook_event_name")
        if name == "SessionEnd":
            try:
                entry = json.loads(path.read_text())
            except (OSError, ValueError):
                return
            # the same session may be open in another process too; only
            # the process that wrote the entry gets to clear it
            if entry.get("pid") == pid:
                path.unlink(missing_ok=True)
            return
        if name != "SessionStart":
            return
        self.ledger_dir.mkdir(parents=True, exist_ok=True)
        record = {
            "session_id": session_id,
            "pid": pid,
            "proc_start": proc_start,
            "cwd": event.get("cwd") or os.getcwd(),
            "transcript_path": event.get("transcript_path") or "",
            "started": time.time(),
        }
        tmp = path.with_name(f".{path.name}.{os.getpid()}")
        tmp.write_text(json.dumps(record))
        os.replace(tmp, path)
        self._prune_ledger()

    def _prune_ledger(self):
        """Drop entries of dead processes that are past recovering: no
        transcript, or nothing happened in it for CRASH_MAX_AGE."""
        cutoff = time.time() - CRASH_MAX_AGE
        for path in self.ledger_dir.glob("*.json"):
            try:
                entry = json.loads(path.read_text())
            except (OSError, ValueError):
                path.unlink(missing_ok=True)
                continue
            if _pid_alive(entry.get("pid"), entry.get("proc_start")):
                continue
            transcript = entry.get("transcript_path") or ""
            try:
                stale = os.path.getmtime(transcript) < cutoff
            except OSError:
                stale = True
            if stale:
                path.unlink(missing_ok=True)

    def dismiss(self, session_ids: list[str]) -> list[str]:
        """Forget that these sessions were left open. Returns the ids that
        had an entry in the ledger."""
        dismissed = []
        for session_id in session_ids:
            path = self.ledger_dir / f"{session_id}.json"
            try:
                path.unlink()
                dismissed.append(session_id)
            except OSError:
                continue
        return dismissed


