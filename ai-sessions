class AskError(Exception):
    """The search session could not be run, or returned nothing usable."""


def _ask_candidates(sessions: list[Session], cap: int = ASK_MAX_CANDIDATES) -> str:
    lines = []
    for s in sessions[:cap]:
        when = (
            datetime.fromtimestamp(s.last_active).strftime("%Y-%m-%d %H:%M")
            if s.last_active else "?"
        )
        lines.append(
            f"{s.session_id}  {when}  "
            f"{_short_path(s.cwd or '?', 40)}  "
            f"{_truncate(s.title or '(no title)', 70)}"
        )
    return "\n".join(lines)


def build_ask_prompt(question: str, sessions: list[Session]) -> str:
    backend = BACKENDS.get("claude")
    claude_dir = (
        str(backend.claude_dir) if isinstance(backend, ClaudeBackend) else "~/.claude"
    )
    return ASK_PROMPT.format(
        question=question,
        claude_dir=claude_dir,
        shown=min(len(sessions), ASK_MAX_CANDIDATES),
        total=len(sessions),
        candidates=_ask_candidates(sessions),
    )


_SESSION_TITLES: dict[str, str] = {}


def _session_hint(text: str) -> str:
    """Title of the first session uuid mentioned in `text`, if it resolves.

    Turns "grep -c certbot 8c2f10ab-….jsonl" into a step that says which of
    my sessions is being dug through, which is the interesting half.
    """
    for match in re.finditer(r"[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}", text):
        session_id = match.group(0)
        if session_id not in _SESSION_TITLES:
            found = _lookup_session(session_id)
            _SESSION_TITLES[session_id] = (found.title if found else "") or ""
        title = _SESSION_TITLES[session_id]
        if title:
            return title
    return ""


def _term_width() -> int:
    return max(40, shutil.get_terminal_size((100, 24)).columns - 1)


def _tool_line(block: dict) -> str:
    """One line describing a tool call, with the session it is about."""
    name = str(block.get("name") or "tool")
    args = block.get("input") if isinstance(block.get("input"), dict) else {}
    if name == "StructuredOutput":
        return "writing up the answer"
    detail = str(
        args.get("command")
        or args.get("pattern")
        or args.get("file_path")
        or args.get("path")
        or args.get("description")
        or ""
    )
    hint = _session_hint(json.dumps(args, ensure_ascii=False))
    # spend the width on the command, but never at the cost of the session
    # title — that is what makes the step readable at a glance
    budget = _term_width() - 14 - len(name) - (len(hint) + 5 if hint else 0)
    line = f"{name} {_truncate(_clean_text(detail), max(20, budget))}".strip()
    return line + (f"  → {hint}" if hint else "")


def _result_line(obj: dict) -> str:
    """The head of a tool result — what the step it closes actually found."""
    text = ""
    content = (obj.get("message") or {}).get("content")
    if isinstance(content, list):
        for block in content:
            if not isinstance(block, dict) or block.get("type") != "tool_result":
                continue
            inner = block.get("content")
            if isinstance(inner, str):
                text = inner
            elif isinstance(inner, list):
                text = "\n".join(
                    b.get("text", "") for b in inner
                    if isinstance(b, dict) and b.get("type") == "text"
                )
            if text:
                break
    raw = obj.get("tool_use_result")
    if not text and isinstance(raw, str):
        text = raw
    elif not text and isinstance(raw, dict):
        text = str(raw.get("stdout") or raw.get("stderr") or raw.get("text") or "")
    lines = [ln for ln in (text or "").splitlines() if ln.strip()]
    if not lines:
        return ""
    head = _clean_text(lines[0])
    if not head:
        return ""
    more = f" (+{len(lines) - 1} more)" if len(lines) > 1 else ""
    hint = _session_hint(head)
    return _truncate(head, 90) + more + (f"  → {hint}" if hint else "")


class AskProgress:
    """Live view of what the search session is doing, on stderr.

    Finished steps scroll; the step in flight stays on one line with a spinner
    and its own clock, so a slow grep reads as work rather than as a hang.
    Without a tty (piped, or inside another tool) the same steps print as
    plain lines and nothing is ever rewritten.
    """

    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    SLOW_STEP = 3.0  # seconds before a finished step is worth timing

    def __init__(self, stream=None):
        self.stream = stream or sys.stderr
        self.tty = self.stream.isatty()
        self.started = time.time()
        self.step_started = self.started
        self.current = ""
        self.marker = "·"
        self.working = False
        self.placeholder = False
        self.frame = 0
        self.lock = threading.Lock()
        self.stopped = threading.Event()
        self.ticker = None

    def __enter__(self):
        if self.tty:
            self.ticker = threading.Thread(target=self._tick, daemon=True)
            self.ticker.start()
        return self

    def __exit__(self, *exc):
        self.close()
        return False

    # -- steps ------------------------------------------------------------

    def step(self, text: str, marker: str = "·"):
        """Start a new step; the previous one is finished and scrolls up."""
        text = _clean_text(text)
        if not text:
            return
        with self.lock:
            self._finish()
            self.current, self.marker = text, marker
            self.working = marker == "»"
            self.placeholder = False
            self.step_started = time.time()
            self._draw()

    def thinking(self, tokens: int):
        """Reasoning tokens tick by while nothing else is happening — the one
        signal that the session is alive between a result and the next tool."""
        with self.lock:
            if self.working or not self.current:
                return  # a tool is running; that is the more useful line
            self.current = f"thinking… ({tokens} tokens)"
            self._draw()

    def note(self, text: str, marker: str = "↳"):
        """Close the current step with what it found, then wait on the model."""
        text = _clean_text(text)
        with self.lock:
            self._finish()
            if text:
                self._writeln(marker, text)
            self.current, self.marker = "thinking…", "·"
            self.working = False
            self.placeholder = True
            self.step_started = time.time()
            self._draw()

    def close(self, summary: str = ""):
        self.stopped.set()
        if self.ticker:
            self.ticker.join(timeout=0.3)
        with self.lock:
            self._finish()
            if summary:
                self._writeln("·", _clean_text(summary))

    # -- rendering --------------------------------------------------------

    def _tick(self):
        while not self.stopped.wait(0.12):
            with self.lock:
                self.frame += 1
                self._draw()

    def _draw(self):
        if not self.tty or not self.current:
            return
        spin = self.FRAMES[self.frame % len(self.FRAMES)]
        elapsed = f"{int(time.time() - self.started)}s"
        body = _truncate(self.current, max(20, _term_width() - len(elapsed) - 6))
        self.stream.write(f"\r\033[2K{DIM}{spin} {body}  {elapsed}{NC}")
        self.stream.flush()

    def _finish(self):
        """Turn the in-flight step into a scrolled line."""
        if not self.current:
            return
        took = time.time() - self.step_started
        if self.placeholder and self.current == "thinking…" and took < 1.0:
            self.current = ""  # never waited on the model: nothing to report
            return
        suffix = f" ({int(took)}s)" if took >= self.SLOW_STEP else ""
        self._writeln(self.marker, self.current + suffix)
        self.current = ""

    def _writeln(self, marker: str, text: str):
        if self.tty:
            self.stream.write("\r\033[2K")
            line = f"{DIM}{marker} {_truncate(text, _term_width() - 2)}{NC}\n"
        else:
            line = f"{marker} {text}\n"
        self.stream.write(line)
        self.stream.flush()


def run_ask_agent(prompt: str, model: str | None = None) -> dict:
    """Run one headless Claude Code session and return its structured answer.

    The session is deliberately plain — no system-prompt surgery, no effort or
    budget overrides — apart from three things the task itself requires: a
    read-only toolset, no MCP servers (nothing here needs them, and loading
    them costs seconds), and no session persistence, so hunting for a session
    never adds a session to the list you are hunting through.

    Its stream is narrated on stderr as it arrives, so a hunt that takes a
    minute is a minute of visible work rather than a blank terminal.
    """
    if not shutil.which("claude"):
        raise AskError("claude is not on PATH — 'ask' needs Claude Code")
    argv = [
        "claude", "-p", prompt,
        "--output-format", "stream-json", "--verbose",
        "--tools", ASK_TOOLS,
        "--permission-mode", "auto",
        "--strict-mcp-config",
        "--no-session-persistence",
        "--json-schema", json.dumps(ASK_SCHEMA),
    ]
    if model:
        argv += ["--model", model]

    started = time.time()
    result = None
    timed_out = threading.Event()
    # stderr goes to a file, not a pipe: nothing reads a pipe until stdout
    # ends, and a chatty stderr would fill it and stall both processes
    errfile = tempfile.TemporaryFile(mode="w+")
    with AskProgress() as progress, errfile:
        progress.step("starting a claude session…", "»")
        try:
            proc = subprocess.Popen(
                argv, stdout=subprocess.PIPE, stderr=errfile,
                text=True, cwd=str(Path.home()),
            )
        except OSError as exc:
            raise AskError(f"could not run claude: {exc}") from exc

        def expire():
            timed_out.set()
            proc.kill()

        # a timer, so a session that goes silent is stopped too
        timer = threading.Timer(ASK_TIMEOUT, expire)
        timer.daemon = True
        timer.start()
        try:
            for line in proc.stdout:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(obj, dict):
                    continue
                kind = obj.get("type")
                if kind == "system" and obj.get("subtype") == "init":
                    progress.step("reading the candidate sessions…")
                elif kind == "system" and obj.get("subtype") == "thinking_tokens":
                    progress.thinking(int(obj.get("estimated_tokens") or 0))
                elif kind == "assistant":
                    for block in (obj.get("message") or {}).get("content") or []:
                        if not isinstance(block, dict):
                            continue
                        if block.get("type") == "text":
                            progress.step(block.get("text", ""))
                        elif block.get("type") == "thinking":
                            progress.step(block.get("thinking", ""))
                        elif block.get("type") == "tool_use":
                            progress.step(_tool_line(block), "»")
                elif kind == "user":
                    progress.note(_result_line(obj))
                elif kind == "result":
                    result = obj  # close() prints the summary line
        except KeyboardInterrupt:
            proc.kill()
            raise AskError("cancelled") from None
        finally:
            timer.cancel()
            if proc.poll() is None:
                proc.wait()

        if timed_out.is_set():
            raise AskError(f"the search took longer than {ASK_TIMEOUT}s")
        errfile.seek(0)
        stderr = errfile.read().strip()
        if result is None:
            detail = stderr.splitlines()[-1] if stderr else "no result was returned"
            raise AskError(f"the search session failed: {detail}")
        if result.get("is_error"):
            raise AskError(
                f"the search session failed: {result.get('subtype') or 'error'}"
            )

        data = result.get("structured_output")
        if not isinstance(data, dict):
            text = _clean_text(str(result.get("result") or ""))
            raise AskError(
                "the search session returned no structured answer"
                + (f":\n{_truncate(text, 400)}" if text else "")
            )
        cost = result.get("total_cost_usd")
        took = int((result.get("duration_ms") or 0) / 1000) or int(time.time() - started)
        progress.close(
            f"done in {took}s"
            + (f" · ${cost:.2f}" if isinstance(cost, (int, float)) else "")
        )
    return data


def _lookup_session(session_id: str) -> Session | None:
    """Build a Session for an id outside the scoped list (claude backend)."""
    backend = BACKENDS.get("claude")
    if not isinstance(backend, ClaudeBackend) or not UUID_RE.match(session_id):
        return None
    projects = backend.claude_dir / "projects"
    try:
        matches = sorted(projects.glob(f"*/{session_id}.jsonl"))
    except OSError:
        return None
    for path in matches:
        try:
            return backend._parse_transcript(path)
        except OSError:
            continue
    return None


def resolve_ask_sessions(items: list, sessions: list[Session]) -> list[Session]:
    """Map the agent's session ids back onto real, resumable sessions."""
    by_id = {s.session_id: s for s in sessions}
    resolved: list[Session] = []
    seen: set[str] = set()
    for item in items:
        if not isinstance(item, dict):
            continue
        session_id = str(item.get("session_id") or "").strip()
        if not session_id or session_id in seen:
            continue
        session = by_id.get(session_id) or _lookup_session(session_id)
        if session is None:
            continue  # an id we cannot find on disk is not resumable
        seen.add(session_id)
        confidence = str(item.get("confidence") or "").strip().lower()
        session.match_note = {"high": "high", "medium": "med", "low": "low"}.get(
            confidence, "claude"
        )
        session.snippet = _clean_text(str(item.get("why") or "")) or "(no reason given)"
        resolved.append(session)
    return resolved

