# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------


def _parse_lines(lines: list[str]) -> list[dict]:
    parsed = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if isinstance(obj, dict):
            parsed.append(obj)
    return parsed


def _parse_ts(value) -> float | None:
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _message_text(obj: dict) -> str:
    content = (obj.get("message") or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                return block.get("text", "")
    return ""


def _clean_text(text: str) -> str:
    text = re.sub(r"<[^>]{1,80}>", " ", text or "")  # strip inline tags
    return " ".join(text.split())


def _boot_time() -> float | None:
    try:
        with open("/proc/uptime") as fh:
            return time.time() - float(fh.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None  # non-Linux: degrade to pid-liveness only


def _proc_stat(pid: int) -> list[bytes] | None:
    """Fields of /proc/<pid>/stat from field 3 (state) on, or None. The
    command name (field 2) may hold spaces and parens, so the fields that
    follow are taken from after its last ')'."""
    try:
        with open(f"/proc/{pid}/stat", "rb") as fh:
            stat = fh.read()
    except OSError:
        return None
    return stat[stat.rfind(b")") + 2:].split()


def _proc_start(pid: int) -> str | None:
    """Start time of `pid` in clock ticks since boot (stat field 22): with
    the pid, an identity that survives neither pid reuse nor a reboot."""
    fields = _proc_stat(pid)
    return fields[19].decode() if fields and len(fields) > 19 else None


def _pid_alive(pid, proc_start=None, since: float = 0.0,
               boot_time: float | None = None) -> bool:
    """Whether the process that wrote a record is still running.

    With `proc_start` (Claude Code's `procStart`, or our ledger's) the check
    is exact. Without it, fall back to "a claude process holds that pid and
    the record is younger than this boot". Without /proc, a plain liveness
    check is all there is.
    """
    if not isinstance(pid, int) or pid <= 0:
        return False
    if not os.path.isdir("/proc"):
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
    current = _proc_start(pid)
    if current is None:
        return False
    if proc_start not in (None, ""):
        return current == str(proc_start)
    if boot_time is not None and since < boot_time:
        return False
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            return b"claude" in fh.read().lower()
    except OSError:
        return False


def _claude_ancestor() -> tuple[int, str] | None:
    """(pid, start time) of the claude process this hook runs under.

    Hooks run through a shell, so the parent is not necessarily claude
    itself; walk up until a process looks like it (the native binary is
    named claude, an npm install is node running .../claude-code/cli.js).
    """
    pid = os.getppid()
    for _ in range(8):
        if pid <= 1:
            return None
        fields = _proc_stat(pid)
        if fields is None or len(fields) <= 19:
            return None
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                argv = fh.read().split(b"\0")[:2]
        except OSError:
            return None
        if any(b"claude" in os.path.basename(a).lower() for a in argv[:1]) or (
            len(argv) > 1 and b"claude" in argv[1].lower()
            and os.path.basename(argv[0]) in (b"node", b"bun")
        ):
            return pid, fields[19].decode()
        pid = int(fields[1])
    return None


def _state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or "~/.local/state"
    return Path(
        os.environ.get("AI_SESSIONS_STATE_DIR") or Path(base) / "ai-sessions"
    ).expanduser()


def _cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or "~/.cache"
    return Path(
        os.environ.get("AI_SESSIONS_CACHE_DIR") or Path(base) / "ai-sessions"
    ).expanduser()


def _relative_time(ts: float | None) -> str:
    if ts is None:
        return "?"
    delta = time.time() - ts
    if delta < 0:
        delta = 0
    if delta < 60:
        return "just now"
    if delta < 3600:
        return f"{int(delta // 60)}m ago"
    if delta < 48 * 3600:
        return f"{int(delta // 3600)}h ago"
    if delta < 14 * 86400:
        return f"{int(delta // 86400)}d ago"
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")


def _short_path(path: str, width: int) -> str:
    home = str(Path.home())
    if path == home:
        path = "~"
    elif path.startswith(home + os.sep):
        path = "~" + path[len(home):]
    if len(path) <= width:
        return path
    parts = path.split(os.sep)
    while len(parts) > 2 and len(os.sep.join(parts)) > width - 2:
        del parts[1 if parts[0] in ("~", "") else 0]
        result = parts[0] + os.sep + "…" + os.sep + os.sep.join(parts[1:])
        if len(result) <= width:
            return result
    return path[: width - 1] + "…"


def _truncate(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"


def _make_snippet(text: str, terms: list[str], width: int = 70) -> str:
    """Window of `text` centred on its first matching term."""
    text = _clean_text(text)
    low = text.lower()
    found = [(low.find(t), t) for t in terms]
    found = [(idx, t) for idx, t in found if idx >= 0]
    if not found:
        return _truncate(text, width)
    idx, term = min(found)
    start = max(0, idx - max(0, (width - len(term)) // 2))
    end = min(len(text), start + width)
    prefix = "…" if start > 0 else ""
    suffix = "…" if end < len(text) else ""
    return prefix + text[start:end] + suffix


# --------------------------------------------------------------------------
# Search
# --------------------------------------------------------------------------

# Relevance weights. Coverage dominates: a session that mentions every term
# beats one that mentions the rarest term a hundred times. Recency only
# nudges — it used to be the sole ordering, which buried the best hits.
W_COVERAGE = 100.0     # query terms present anywhere in the session
W_CONVERSATION = 30.0  # ... and present in conversation, not just tool output
W_PHRASE = 45.0        # the whole query appears verbatim
W_PROXIMITY = 30.0     # best single message's own term coverage
W_TITLE = 20.0         # terms in the session title
W_USER_FREQ = 20.0     # repetition in my own prompts
W_ASSIST_FREQ = 10.0   # repetition in replies
W_RAW_FREQ = 5.0       # repetition in tool output (--everything)
W_RECENCY = 10.0       # decays with a 45-day half-life
FREQ_SATURATION = 25   # match count at which a frequency term maxes out

TERM_RE = re.compile(r'"([^"]*)"|(\S+)')


def parse_query(query: str) -> list[str]:
    """Split a query into terms; "quoted text" stays a single term."""
    terms: list[str] = []
    for quoted, bare in TERM_RE.findall(query):
        term = (quoted or bare).strip().lower()
        if term and term not in terms:
            terms.append(term)
    return terms


def query_phrase(query: str) -> str:
    """The whole query as one contiguous phrase, or "" if that's meaningless."""
    if '"' in query:
        return ""  # explicit quoting already expresses the phrase
    phrase = " ".join(query.lower().split())
    return phrase if " " in phrase else ""


def _grep_hits(terms: list[str], paths: list[str]) -> dict[str, set[str]]:
    """Per-term set of files containing it anywhere (a cheap prefilter).

    Doubles as document frequency for the IDF weights. Falls back to "every
    term is in every file" when grep is unavailable, which degrades to a full
    scan with uniform term weights.
    """
    # a UTF-8 locale, so -i folds å/Å the way str.lower() does
    env = dict(os.environ, LC_ALL="C.UTF-8")
    hits: dict[str, set[str]] = {}
    for term in terms:
        matched: set[str] = set()
        for chunk in (paths[i:i + 500] for i in range(0, len(paths), 500)):
            try:
                result = subprocess.run(
                    ["grep", "-l", "-i", "-F", "-s", "--", term, *chunk],
                    capture_output=True, text=True, env=env,
                )
            except OSError:
                return {t: set(paths) for t in terms}  # no grep available
            # 2 means some file could not be read (vanished, permissions);
            # the matches it did print still hold
            matched.update(p for p in result.stdout.splitlines() if p)
        hits[term] = matched
    return hits


# --------------------------------------------------------------------------
# Text index
# --------------------------------------------------------------------------
#
# Searching straight through the transcripts means lowercasing a gigabyte of
# mostly tool output on every keystroke. The index keeps only the
# conversation text, one message per line as `<kind>\t<text>`, extracted once
# per transcript and then extended as the transcript grows.

INDEX_KINDS = {"user": "u", "assistant": "a", "title": "t", "prompt": "p"}
INDEX_SUBAGENT = "s"  # anything said inside a subagent
_INDEX_MARKERS = tuple(
    marker
    for kind in (b"user", b"assistant", b"ai-title", b"last-prompt")
    for marker in (b'"type":"' + kind + b'"', b'"type": "' + kind + b'"')
)


class TextIndex:
    """Conversation text of each transcript, kept in step with it.

    `manifest.json` records, per transcript, the size and mtime it was
    indexed at, the byte offset reached, the 32 bytes before that offset
    and the size of the text file. A transcript that only grew (the usual
    case: it is append-only JSONL) is extended from the offset; anything
    else (the bytes before the offset changed, it shrank) is rebuilt.
    A run killed half way (fzf kills superseded searches) leaves the
    manifest behind the text file, so the next run truncates the text back
    to the recorded size before appending, and nothing is doubled.
    """

    VERSION = 1

    def __init__(self, root: Path):
        self.root = root
        self.manifest_path = root / "manifest.json"

    def update(self, sources: dict[str, tuple["Backend", bool]]) -> dict[str, str]:
        """Bring the index up to date for `sources` ({transcript path:
        (backend, is the session's own transcript)}) and return {transcript
        path: text file} for each one indexed. Anything that cannot be
        indexed is left out, for the caller to search the raw way."""
        try:
            self.root.mkdir(parents=True, exist_ok=True)
            lock = open(self.root / ".lock", "w")
        except OSError:
            return {}
        try:
            if fcntl is not None:
                fcntl.flock(lock, fcntl.LOCK_EX)
            manifest = self._load()
            dirty = self._collect_garbage(manifest)
            saved = time.monotonic()
            indexed = {}
            for src, (backend, is_main) in sources.items():
                text_path = self.root / (
                    hashlib.sha1(src.encode()).hexdigest()[:24] + ".txt"
                )
                try:
                    dirty |= self._refresh(src, text_path, backend, is_main,
                                           manifest)
                except OSError:
                    manifest.pop(src, None)
                    continue
                indexed[src] = str(text_path)
                if dirty and time.monotonic() - saved > 2:
                    # a first build takes a while; keep what is done if
                    # this run gets killed
                    self._save(manifest)
                    dirty, saved = False, time.monotonic()
            if dirty:
                self._save(manifest)
            return indexed
        except OSError:
            return {}
        finally:
            lock.close()

    def _refresh(self, src: str, text_path: Path, backend: "Backend",
                 is_main: bool, manifest: dict) -> bool:
        """Index one transcript if it changed; True if the manifest did."""
        st = os.stat(src)
        entry = manifest.get(src)
        current = isinstance(entry, dict) and entry.get("v") == self.VERSION
        if (current and entry["size"] == st.st_size
                and entry["mtime"] == st.st_mtime_ns and text_path.exists()):
            return False
        append = (
            current
            and st.st_size >= entry["offset"]
            and text_path.exists()
            and text_path.stat().st_size >= entry["text_size"]
            and self._tail(src, entry["offset"]) == entry["tail"]
        )
        with open(src, "rb") as fh, \
                open(text_path, "r+b" if append else "wb") as out:
            offset = 0
            if append:
                offset = entry["offset"]
                fh.seek(offset)
                out.truncate(entry["text_size"])
                out.seek(entry["text_size"])
            for line in fh:
                if not line.endswith(b"\n"):
                    break  # still being written; picked up next time
                offset += len(line)
                if not any(m in line for m in _INDEX_MARKERS):
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(obj, dict):
                    continue
                said = backend.conversation_line(obj)
                if said is None:
                    continue
                kind, text = said
                if is_main:
                    code = INDEX_KINDS.get(kind)
                elif kind in ("user", "assistant"):
                    code = INDEX_SUBAGENT
                else:
                    code = None
                text = " ".join(text.split())
                if code and text:
                    out.write(f"{code}\t{text}\n".encode("utf-8", "replace"))
            text_size = out.tell()
        manifest[src] = {
            "v": self.VERSION,
            "size": st.st_size,
            "mtime": st.st_mtime_ns,
            "offset": offset,
            "tail": self._tail(src, offset),
            "text_size": text_size,
            "text": text_path.name,
        }
        return True

    @staticmethod
    def _tail(path: str, offset: int) -> str:
        with open(path, "rb") as fh:
            fh.seek(max(0, offset - 32))
            return fh.read(min(32, offset)).hex()

    def _collect_garbage(self, manifest: dict) -> bool:
        """Forget transcripts that are gone, and their text."""
        gone = [src for src in manifest if not os.path.exists(src)]
        for src in gone:
            entry = manifest.pop(src)
            if isinstance(entry, dict) and entry.get("text"):
                (self.root / entry["text"]).unlink(missing_ok=True)
        return bool(gone)

    def _load(self) -> dict:
        try:
            manifest = json.loads(self.manifest_path.read_text())
        except (OSError, ValueError):
            return {}
        return manifest if isinstance(manifest, dict) else {}

    def _save(self, manifest: dict):
        tmp = self.manifest_path.with_name(f".manifest.{os.getpid()}")
        tmp.write_text(json.dumps(manifest))
        os.replace(tmp, self.manifest_path)


# --------------------------------------------------------------------------
# Scanning and scoring
# --------------------------------------------------------------------------


def _new_stats() -> dict:
    return {
        "matched": set(),      # terms found in conversation text
        "raw_matched": set(),  # terms found only in tool output
        "user": 0,            # matching messages I wrote
        "assistant": 0,       # matching replies (and subagent text)
        "raw": 0,             # matching tool-output lines
        "phrase": False,
        "best_rank": -1.0,
        "best_hits": (),      # terms of the most on-point single message
        "snippet_text": "",
    }


def _count_message(stats: dict, kind: str, text: str, hits: list[str],
                   phrase: str):
    """Fold one conversation message that matched `hits` into `stats`."""
    stats["matched"].update(hits)
    if kind in ("t", "p"):
        return  # metadata mirroring the title/prompt: no double count
    is_user = kind == "u"
    stats["user" if is_user else "assistant"] += 1
    line_phrase = bool(phrase) and phrase in text.lower()
    stats["phrase"] = stats["phrase"] or line_phrase
    rank = (len(hits) + (0.5 if line_phrase else 0.0)
            + (0.2 if is_user else 0.0)
            - (0.3 if kind == INDEX_SUBAGENT else 0.0))
    if rank > stats["best_rank"]:
        stats["best_rank"] = rank
        stats["best_hits"] = tuple(hits)
        stats["snippet_text"] = text


def _scan_index(path: str, terms: list[str], phrase: str, stats: dict) -> bool:
    """Scan one index file into `stats`; False if it is unreadable."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                kind, _, text = line.rstrip("\n").partition("\t")
                low = text.lower()
                hits = [t for t in terms if t in low]
                if hits:
                    _count_message(stats, kind, text, hits, phrase)
    except OSError:
        return False
    return True


def _json_strings(value) -> str:
    """Every string value in a JSON object, joined: what a person could
    have meant by "this word appears", without the keys (`type`,
    `content`, ... appear on every line) or encoded blobs."""
    out: list[str] = []

    def walk(v):
        if isinstance(v, str):
            out.append(v)
        elif isinstance(v, list):
            for item in v:
                walk(item)
        elif isinstance(v, dict):
            if v.get("type") == "base64":
                return  # an embedded image or document
            for key, item in v.items():
                if key != "signature":  # thinking signatures are base64
                    walk(item)

    walk(value)
    return "\n".join(out)


def _scan_raw(path: str, backend: "Backend", is_main: bool, terms: list[str],
              phrase: str, everything: bool, stats: dict) -> bool:
    """Scan one transcript straight from its JSONL into `stats`: the
    --everything path, and the fallback when it could not be indexed."""
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                low = line.lower()
                if not any(t in low for t in terms):
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(obj, dict):
                    continue
                said = backend.conversation_line(obj)
                if said is not None:
                    kind, text = said
                    text = " ".join(text.split())
                    hits = [t for t in terms if t in text.lower()]
                    if hits:
                        if is_main:
                            code = INDEX_KINDS.get(kind, "a")
                        elif kind in ("user", "assistant"):
                            code = INDEX_SUBAGENT
                        else:
                            continue
                        _count_message(stats, code, text, hits, phrase)
                        continue
                if everything:
                    values = _json_strings(obj).lower()
                    raw_hits = [t for t in terms if t in values]
                    if raw_hits:
                        stats["raw"] += 1
                        stats["raw_matched"].update(raw_hits)
    except OSError:
        return False
    return True


def _recency_bonus(last_active: float | None) -> float:
    if not last_active:
        return 0.0
    age_days = max(0.0, (time.time() - last_active) / 86400)
    return W_RECENCY * 0.5 ** (age_days / 45.0)


def _score(stats: dict, session: Session, terms: list[str],
           idf: dict[str, float]) -> float:
    total = sum(idf.values()) or 1.0

    def weight(found) -> float:
        return sum(idf[t] for t in found if t in idf) / total

    def freq(n: int) -> float:
        return min(1.0, math.log1p(n) / math.log1p(FREQ_SATURATION))

    title = (session.title or "").lower()
    return (
        W_COVERAGE * weight(stats["matched"] | stats["raw_matched"])
        + W_CONVERSATION * weight(stats["matched"])
        + W_PHRASE * (1.0 if stats["phrase"] else 0.0)
        + W_PROXIMITY * weight(stats["best_hits"])
        + W_TITLE * weight([t for t in terms if t in title])
        + W_USER_FREQ * freq(stats["user"])
        + W_ASSIST_FREQ * freq(stats["assistant"])
        + W_RAW_FREQ * freq(stats["raw"])
        + _recency_bonus(session.last_active)
    )


def run_search(sessions: list[Session], terms: list[str], phrase: str,
               everything: bool, recent_first: bool = False,
               ) -> tuple[list[Session], bool]:
    """Rank sessions by how well they match `terms`.

    A session is searched through its own transcript and its subagents'.
    Without --everything that goes through the text index; with it, the raw
    transcripts are read so tool output can match too.

    Sessions matching every term win; only if none does are partial matches
    shown, and the returned flag says so. Returns (results, relaxed).
    """
    searchable = [s for s in sessions if s.transcript_path]
    if not searchable or not terms:
        return [], False
    sources = [
        (path, s, path == s.transcript_path)
        for s in searchable
        for path in [s.transcript_path, *s.subagent_paths]
    ]
    indexed = {} if everything else TextIndex(_cache_dir() / "index").update(
        {path: (BACKENDS[s.backend], is_main) for path, s, is_main in sources}
    )
    # file to grep and scan -> (session, is the session's own transcript,
    # is an index file rather than raw JSONL)
    files: dict[str, tuple[Session, bool, bool]] = {}
    for path, s, is_main in sources:
        if path in indexed:
            files[indexed[path]] = (s, is_main, True)
        else:
            files[path] = (s, is_main, False)

    file_hits = _grep_hits(terms, list(files))
    hits = {
        t: {files[f][0].session_id for f in found}
        for t, found in file_hits.items()
    }
    total_docs = len(searchable)
    idf = {
        t: math.log(1 + total_docs / (1 + len(hits.get(t, ()))))
        for t in terms
    }
    strict = set.intersection(*(hits[t] for t in terms))
    hit_files = set().union(*file_hits.values())
    files_of: dict[str, list[str]] = {}
    for f, (s, _, _) in files.items():
        if f in hit_files:
            files_of.setdefault(s.session_id, []).append(f)
    by_id = {s.session_id: s for s in searchable}

    scanned: dict[str, dict] = {}

    def scan(candidates) -> list[Session]:
        found = []
        for session_id in candidates:
            session = by_id[session_id]
            stats = scanned.get(session_id)
            if stats is None:
                stats = _new_stats()
                for f in files_of.get(session_id, ()):
                    _, is_main, is_index = files[f]
                    if is_index:
                        _scan_index(f, terms, phrase, stats)
                    else:
                        _scan_raw(f, BACKENDS[session.backend], is_main,
                                  terms, phrase, everything, stats)
                scanned[session_id] = stats
            matched = stats["matched"] | stats["raw_matched"]
            if not matched:
                continue
            session.match_count = stats["user"] + stats["assistant"] + stats["raw"]
            session.term_hits = len(matched)
            session.term_total = len(terms)
            session.score = _score(stats, session, terms, idf)
            session.snippet = (
                _make_snippet(stats["snippet_text"], terms)
                if stats["snippet_text"] else "(match in tool output)"
            )
            found.append(session)
        return found

    results = [s for s in scan(strict) if s.term_hits == len(terms)]
    relaxed = False
    if not results:
        results = scan(strict | set().union(*hits.values()))
        relaxed = len(terms) > 1 and bool(results)

    if recent_first:
        results.sort(key=lambda s: s.last_active or 0, reverse=True)
    else:
        results.sort(key=lambda s: (s.score, s.last_active or 0), reverse=True)
    return results, relaxed


