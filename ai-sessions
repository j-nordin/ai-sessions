def gather(args) -> list[Session]:
    sessions: list[Session] = []
    for name, backend in BACKENDS.items():
        if args.backend and name != args.backend:
            continue
        sessions.extend(backend.discover())

    if not args.json:
        sessions = [s for s in sessions if s.has_messages]
    if args.here:
        base = os.getcwd()
        sessions = [
            s for s in sessions
            if s.cwd == base or s.cwd.startswith(base + os.sep)
        ]
    if args.project:
        base = str(Path(args.project).expanduser().resolve())
        sessions = [
            s for s in sessions
            if s.cwd == base or s.cwd.startswith(base + os.sep)
        ]
    sessions.sort(key=lambda s: s.last_active or 0, reverse=True)
    return sessions


def render_rows(sessions: list[Session], color: bool, show_matches: bool = False) -> list[str]:
    term_width = shutil.get_terminal_size((120, 24)).columns
    project_w = 24
    id_w = 8
    time_w = 11
    matches_w = (
        max(7, *(len(s.match_label) for s in sessions)) if show_matches and sessions
        else 7 if show_matches else 0
    )
    show_backend = len({s.backend for s in sessions}) > 1
    backend_w = 8 if show_backend else 0
    fixed = (2 + time_w + 2 + project_w + 2 + id_w + 2
             + (backend_w + 2 if show_backend else 0)
             + (matches_w + 2 if show_matches else 0))
    title_w = max(20, min(term_width - fixed, 60))

    def paint(text, code):
        return f"{code}{text}{NC}" if color else text

    header = (
        "   "
        + "LAST ACTIVE".ljust(time_w + 2)
        + ("BACKEND".ljust(backend_w + 2) if show_backend else "")
        + "PROJECT".ljust(project_w + 2)
        + "TITLE".ljust(title_w + 2)
        + ("MATCHES".ljust(matches_w + 2) if show_matches else "")
        + "ID"
    )
    rows = [paint(header, DIM)]
    for s in sessions:
        if s.status == STATUS_RUNNING:
            marker = paint("●", GREEN)
        elif s.status == STATUS_CRASHED:
            marker = paint("✗", YELLOW)
        else:
            marker = " "
        line = (
            f" {marker} "
            + _relative_time(s.last_active).ljust(time_w + 2)
            + ((s.backend.ljust(backend_w + 2)) if show_backend else "")
            + _short_path(s.cwd or "?", project_w).ljust(project_w + 2)
            + _truncate(s.title or "(no title)", title_w).ljust(title_w + 2)
            + (s.match_label.ljust(matches_w + 2) if show_matches else "")
            + s.session_id[:id_w]
        )
        if s.status == STATUS_CRASHED and color:
            line = f"{YELLOW}{line}{NC}"
        rows.append(line)
    return rows


def render_snippet(session: Session, terms: list[str], color: bool, width: int) -> str:
    snippet = _truncate(session.snippet, width)
    if not color or not terms:
        return snippet
    # highlight every matched term inside the dimmed snippet; longest first so
    # a term that contains another still highlights as one run
    pattern = re.compile(
        "|".join(re.escape(t) for t in sorted(terms, key=len, reverse=True)),
        re.IGNORECASE,
    )
    lit = pattern.sub(lambda m: f"{NC}{YELLOW}{m.group(0)}{NC}{DIM}", snippet)
    return f"{DIM}{lit}{NC}"


def cmd_list(args):
    sessions = gather(args)
    if args.json:
        print(json.dumps([_session_json(s) for s in sessions[: args.limit]], indent=2))
        return 0
    if not sessions:
        print("no sessions found")
        return 0
    color = sys.stdout.isatty()
    for row in render_rows(sessions[: args.limit], color):
        print(row)
    crashed = [s for s in sessions if s.status == STATUS_CRASHED]
    if crashed and not args.crashed_only:
        n = len(crashed)
        plural = "s were" if n > 1 else " was"
        hint = (
            f"\n{n} session{plural} open when the machine last went down"
            f" — 'ai-sessions crashed' to review"
        )
        print(f"{YELLOW}{hint}{NC}" if color else hint)
    return 0


def cmd_crashed(args):
    args.crashed_only = True
    sessions = [s for s in gather(args) if s.status == STATUS_CRASHED]
    if args.json:
        print(json.dumps([_session_json(s) for s in sessions], indent=2))
        return 0
    if not sessions:
        print("no sessions were left open — nothing to recover")
        return 0
    color = sys.stdout.isatty()
    for row in render_rows(sessions, color):
        print(row)
    print("\nresume one with: ai-sessions pick")
    return 0


PREVIEW_MAX_BYTES = 2 * 1024 * 1024


def cmd_preview(path: str) -> int:
    """Render one transcript as a readable conversation (fzf preview pane)."""
    if not path or path == "-" or not os.path.isfile(path):
        print("(no transcript on disk)")
        return 0
    backend = BACKENDS["claude"]
    header_done = False
    try:
        size = os.path.getsize(path)
        with open(path, errors="replace") as fh:
            if size > PREVIEW_MAX_BYTES:
                fh.seek(size - PREVIEW_MAX_BYTES)
                fh.readline()  # drop partial line
                print(f"{DIM}… earlier conversation truncated …{NC}\n")
            for line in fh:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(obj, dict):
                    continue
                kind = obj.get("type")
                if kind not in ("user", "assistant"):
                    continue
                text = backend.searchable_text(obj)
                if not text or not text.strip():
                    continue
                if not header_done:
                    cwd = obj.get("cwd", "")
                    ts = obj.get("timestamp", "")[:16].replace("T", " ")
                    print(f"{DIM}{_short_path(cwd, 60)}   started {ts}{NC}\n")
                    header_done = True
                text = text.strip()
                if kind == "user":
                    print(f"{GREEN}{BOLD}❯ {text}{NC}")
                else:
                    print(text)
                print()
    except OSError:
        print("(transcript unreadable)")
    return 0


def choose_and_resume(sessions: list[Session], rows: list[str],
                      reload_argv: list[str] | None = None,
                      query: str = "",
                      ask_argv: list[str] | None = None) -> int:
    chosen = (_fzf_choose(sessions, rows, reload_argv, query, ask_argv)
              or _prompt_choose(sessions, rows))
    if chosen is None:
        return 1
    backend = BACKENDS[chosen.backend]
    cwd = chosen.cwd if chosen.cwd and os.path.isdir(chosen.cwd) else str(Path.home())
    os.chdir(cwd)
    argv = backend.resume_argv(chosen)
    try:
        os.execvp(argv[0], argv)
    except OSError as exc:
        print(f"error: could not run {argv[0]}: {exc}", file=sys.stderr)
        return 1


def cmd_pick(args):
    sessions = gather(args)
    if args.crashed_only:
        sessions = [s for s in sessions if s.status == STATUS_CRASHED]
    sessions = sessions[: args.limit]
    if not sessions:
        print("no sessions found", file=sys.stderr)
        return 1
    rows = render_rows(sessions, color=True)[1:]  # skip header
    return choose_and_resume(sessions, rows, _scope_argv(args, window=True),
                             ask_argv=_ask_argv(args))


def _scope_argv(args, window: bool = False) -> list[str]:
    """The scope flags to replay in the picker's live search, so that typing
    searches exactly the sessions the picker was populated from.

    `window` confines the search to the -n rows on screen — right for the
    plain picker, which offers a recent window. `search` populates from the
    whole scoped set instead, so it leaves this off and stays broad.
    """
    argv = ["-n", str(args.limit)]
    if args.here:
        argv.append("--here")
    if args.project:
        argv += ["--project", args.project]
    if args.backend:
        argv += ["--backend", args.backend]
    if args.everything:
        argv.append("--everything")
    if args.recent:
        argv.append("--recent")
    if getattr(args, "crashed_only", False):
        argv.append("--crashed-only")
    if window:
        argv.append("--window")
    return argv


def _ask_argv(args) -> list[str]:
    """The scope flags to replay when the picker hands the hunt to claude.

    Deliberately without `-n`: the query you typed came up short, so the
    search should widen to every session in scope, not the rows on screen.
    """
    argv = []
    if args.here:
        argv.append("--here")
    if args.project:
        argv += ["--project", args.project]
    if args.backend:
        argv += ["--backend", args.backend]
    if getattr(args, "model", None):
        argv += ["--model", args.model]
    return argv


def cmd_rows(argv: list[str]) -> int:
    """One page of picker feed: the recent list, or ranked hits for a query.

    Internal — fzf runs this on every keystroke (see _fzf_choose).
    """
    parser = argparse.ArgumentParser(prog="ai-sessions _rows", add_help=False)
    _add_scope_args(parser)
    parser.add_argument("--crashed-only", action="store_true")
    parser.add_argument("--window", action="store_true")
    parser.add_argument("query", nargs="*")
    args = parser.parse_args(argv)
    sessions = gather(args)
    if args.crashed_only:
        sessions = [s for s in sessions if s.status == STATUS_CRASHED]
    if args.window:
        # the picker holds this many rows, so this is the set on screen —
        # search it and nothing else, or typing would surface sessions the
        # list never offered. `-n` widens what is listed and searched at once.
        sessions = sessions[: args.limit]

    query = " ".join(args.query).strip()
    terms = parse_query(query)
    if len(query) < 2 or not terms:
        # a single character matches nearly everything; not worth a scan
        print(_feed(sessions, render_rows(sessions, color=True)[1:]))
        return 0

    results, _ = run_search(
        sessions, terms, query_phrase(query), args.everything, args.recent
    )
    # content search never looks at the project path, but filtering the
    # picker by project used to work — keep it reachable by appending
    # path-only matches after the ranked hits
    seen = {s.session_id for s in results}
    extra = [
        s for s in sessions
        if s.session_id not in seen
        and all(t in (s.cwd or "").lower() for t in terms)
    ]
    for s in extra:
        s.match_note = "path"
        s.snippet = "(matches the project path)"
    results = (results + extra)[: args.limit]

    rows = render_rows(results, color=True, show_matches=True)[1:]
    rows = [
        row + "  " + render_snippet(s, terms, color=True, width=60)
        for row, s in zip(rows, results)
    ]
    print(_feed(results, rows))
    return 0


def cmd_search(args):
    sessions = gather(args)
    terms = parse_query(args.query)
    if not terms:
        print("search requires a query", file=sys.stderr)
        return 1
    results, relaxed = run_search(
        sessions, terms, query_phrase(args.query), args.everything, args.recent
    )
    if args.json:
        out = []
        for s in results[: args.limit]:
            record = _session_json(s)
            record["match_count"] = s.match_count
            record["terms_matched"] = s.term_hits
            record["terms_total"] = s.term_total
            record["score"] = round(s.score, 2)
            record["snippet"] = s.snippet
            out.append(record)
        print(json.dumps(out, indent=2))
        return 0
    if not results:
        print(f"no sessions match {args.query!r}"
              + ("" if args.everything else " — try --everything to include tool output")
              + f"\nor let claude search: ai-sessions ask {args.query}")
        return 1
    results = results[: args.limit]
    color = sys.stdout.isatty()
    note = ""
    if relaxed:
        note = (f"no session mentions all {len(terms)} terms"
                " — showing the best partial matches;"
                " alt-enter hands the hunt to claude")

    if color:
        rows = render_rows(results, color=True, show_matches=True)[1:]
        rows = [
            row + "  " + render_snippet(s, terms, color=True, width=60)
            for row, s in zip(rows, results)
        ]
        if note:
            print(f"{YELLOW}{note}{NC}")
        # seed the picker with this query so editing it re-searches
        return choose_and_resume(results, rows, _scope_argv(args), args.query,
                                 ask_argv=_ask_argv(args))

    if note:
        print(note)
    rows = render_rows(results, color, show_matches=True)
    print(rows[0])
    for row, s in zip(rows[1:], results):
        print(row)
        print("     " + render_snippet(s, terms, color, width=100))
    return 0


def cmd_ask(args):
    """Let a Claude Code session do the searching, then pick from its answer."""
    question = (getattr(args, "question", "") or "").strip()
    if not question:
        print("ask needs a question, e.g.: ai-sessions ask "
              "'where did I sort out the cert that keeps expiring'",
              file=sys.stderr)
        return 1
    sessions = gather(args)
    if not sessions:
        print("no sessions found", file=sys.stderr)
        return 1
    try:
        data = run_ask_agent(build_ask_prompt(question, sessions), args.model)
    except AskError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    answer = _clean_text(str(data.get("answer") or ""))
    results = resolve_ask_sessions(data.get("sessions") or [], sessions)

    if args.json:
        out = {
            "question": question,
            "answer": answer,
            "sessions": [
                dict(_session_json(s), why=s.snippet, confidence=s.match_note)
                for s in results[: args.limit]
            ],
        }
        print(json.dumps(out, indent=2))
        return 0

    color = sys.stdout.isatty()
    if answer:
        width = min(100, max(50, shutil.get_terminal_size((100, 24)).columns - 2))
        text = "\n".join(textwrap.wrap(answer, width))
        print(f"{DIM}{text}{NC}\n" if color else f"{text}\n")
    if not results:
        print("claude found no matching session")
        return 1

    results = results[: args.limit]
    terms = parse_query(question)
    if color:
        rows = render_rows(results, color=True, show_matches=True)[1:]
        rows = [
            row + "  " + render_snippet(s, terms, color=True, width=60)
            for row, s in zip(rows, results)
        ]
        # no live search over these rows: the set *is* claude's answer. Asking
        # again (alt-enter) re-runs the hunt with a reworded question.
        return choose_and_resume(results, rows, ask_argv=_ask_argv(args))
    rows = render_rows(results, color, show_matches=True)
    print(rows[0])
    for row, s in zip(rows[1:], results):
        print(row)
        print("     " + render_snippet(s, terms, color, width=100))
    return 0


def _feed(sessions, rows) -> str:
    """fzf input: the fields needed to resume or preview, then the rendered
    row — the only visible part. Rows never contain tabs (titles go through
    _clean_text), so tab is a safe delimiter.
    """
    return "\n".join(
        f"{s.session_id}\t{s.backend}\t{s.cwd or ''}\t"
        f"{s.transcript_path or '-'}\t{row}"
        for s, row in zip(sessions, rows)
    )


# alt-enter is the key; ctrl-g is the same thing for terminals that swallow it
ASK_KEYS = ("alt-enter", "ctrl-g")


def _exec_ask(ask_argv: list[str], question: str) -> None:
    """Re-enter as `ai-sessions ask` on the terminal the picker was called on.

    fzf's own `become` action would run the search in fzf's place — but fzf's
    stdout and stderr are the pipes this process reads the selection through,
    so the search would narrate itself into a pipe and print its results into
    one too, which looks exactly like nothing happening. Having fzf report the
    key and the query back instead puts the search where the picker was: on
    the real terminal.
    """
    script = os.path.abspath(sys.argv[0])
    question = question.strip()
    if not question:
        print("nothing typed — type what you are looking for, then ask",
              file=sys.stderr)
        os.execv(sys.executable, [sys.executable, script, "pick", *ask_argv])
    os.execv(sys.executable,
             [sys.executable, script, "ask", *ask_argv, "--", question])


def _fzf_choose(sessions, rows, reload_argv=None, query="",
                ask_argv=None) -> Session | None:
    if not shutil.which("fzf"):
        return None
    script = shlex.quote(os.path.abspath(sys.argv[0]))
    argv = [
        "fzf", "--ansi", "--delimiter=\t", "--with-nth=5..",
        "--height=~50%", "--reverse", "--no-sort",
        "--prompt=session> ",
        "--preview", f"{script} _preview {{4}}",
        "--preview-window", "right,60%,wrap,hidden",
        "--bind", "ctrl-/:toggle-preview",
    ]
    keys = ["ctrl-/ preview", "enter resume", "esc quit"]
    prefix = ""
    if ask_argv is not None:
        # The typed query searches for words. When the words are wrong, the
        # same query becomes a question for a claude session: fzf reports the
        # key and the query it had, and _exec_ask takes it from there.
        argv += ["--expect=" + ",".join(ASK_KEYS), "--print-query"]
        keys.insert(0, f"{ASK_KEYS[0]} ask claude")
    if reload_argv is not None:
        # Typing has to search conversation content, not just the visible
        # row. fzf can't match fields it doesn't display, so hand every
        # keystroke to our own ranked search instead of filtering locally.
        # fzf kills a running reload when the query changes again, so the
        # leading sleep lets a superseded query die before it costs a scan.
        flags = " ".join(shlex.quote(a) for a in reload_argv)
        argv += [
            "--disabled",
            "--bind",
            f"change:reload:sleep 0.15; {script} _rows {flags} -- {{q}} || true",
            "--query", query,
        ]
        scope = (f"these {len(sessions)} sessions" if "--window" in reload_argv
                 else "every session")
        prefix = f"type to search {scope} · "
    argv += ["--header", prefix + " · ".join(keys)]
    try:
        result = subprocess.run(
            argv, input=_feed(sessions, rows), capture_output=True, text=True,
        )
    except OSError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        sys.exit(0)  # cancelled
    lines = result.stdout.split("\n")
    if ask_argv is not None:
        # --print-query --expect prints the query, then the key pressed (empty
        # for a plain enter), then the selection
        typed = lines.pop(0) if lines else ""
        pressed = lines.pop(0) if lines else ""
        if pressed in ASK_KEYS:
            _exec_ask(ask_argv, typed)  # never returns
    # the reloaded list is built by a child process, so the chosen line
    # carries everything needed to resume rather than an index into `sessions`
    chosen = next((ln for ln in lines if ln.strip()), "")
    fields = chosen.rstrip("\n").split("\t")
    if len(fields) < 4 or fields[1] not in BACKENDS:
        return None
    return Session(
        backend=fields[1], session_id=fields[0], cwd=fields[2],
        title="", created=None, last_active=None, transcript_path=fields[3],
    )


def _prompt_choose(sessions, rows) -> Session | None:
    if not sys.stdout.isatty():
        rows = [re.sub(r"\033\[[0-9;]*m", "", row) for row in rows]
    for i, row in enumerate(rows):
        print(f"{i:3}  {row}")
    try:
        raw = input("session number> ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if not raw.isdigit() or int(raw) >= len(sessions):
        print("invalid selection", file=sys.stderr)
        return None
    return sessions[int(raw)]


def _session_json(s: Session) -> dict:
    def iso(ts):
        if ts is None:
            return None
        return datetime.fromtimestamp(ts, tz=timezone.utc).isoformat()

    return {
        "backend": s.backend,
        "session_id": s.session_id,
        "cwd": s.cwd,
        "title": s.title,
        "created": iso(s.created),
        "last_active": iso(s.last_active),
        "status": s.status,
    }


def _add_scope_args(parser):
    """Flags that select and shape the session set, shared by the user-facing
    parser and the picker's internal _rows helper."""
    parser.add_argument("-n", "--limit", type=int, default=20,
                        help="max rows to show (default: 20)")
    parser.add_argument("--here", action="store_true",
                        help="only sessions under the current directory")
    parser.add_argument("--project", metavar="PATH",
                        help="only sessions under PATH")
    parser.add_argument("--backend", choices=sorted(BACKENDS),
                        help="only this backend")
    parser.add_argument("--json", action="store_true",
                        help="machine-readable output")
    parser.add_argument("--everything", action="store_true",
                        help="search: also match tool output "
                             "(command results, file contents)")
    parser.add_argument("--recent", action="store_true",
                        help="search: order hits by last activity instead of "
                             "relevance")
    parser.add_argument("--model", metavar="MODEL",
                        help="ask: model for the search session "
                             "(default: your Claude Code default)")


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    if argv and argv[0] == "_preview":  # fzf preview helper, not user-facing
        return cmd_preview(argv[1] if len(argv) > 1 else "")
    if argv and argv[0] == "_rows":  # fzf reload helper, not user-facing
        return cmd_rows(argv[1:])
    parser = argparse.ArgumentParser(
        prog="ai-sessions",
        description="Overview and recovery of AI CLI coding sessions.",
    )
    _add_scope_args(parser)
    parser.add_argument("command", nargs="?", default=None,
                        choices=["list", "pick", "crashed", "search", "ask"],
                        help="pick (fzf + resume; default on a terminal), "
                             "list (table; default when piped), "
                             "crashed (sessions open at last shutdown), "
                             "search <query> (full-text search + resume), "
                             "ask <question> (let claude find the session)")
    parser.add_argument("query", nargs="*",
                        help="terms to search for (search), or a question in "
                             "plain words (ask); every search term must appear, "
                             "a quoted group matches as a phrase")
    args = parser.parse_args(argv)
    # `ask` takes the words as written — it is a question, not a term list
    args.question = " ".join(args.query)
    # a shell-quoted group arrives as one argv element with spaces in it —
    # re-quote it so parse_query keeps it together as a phrase
    args.query = " ".join(
        f'"{part}"' if any(c.isspace() for c in part) else part
        for part in args.query
    )
    if args.command is None:
        interactive = sys.stdout.isatty() and not args.json
        args.command = "pick" if interactive else "list"
    if args.command == "search" and not args.query:
        parser.error("search requires a query, e.g.: ai-sessions search \"flaky test\"")
    if args.command == "ask" and not args.question:
        parser.error("ask requires a question, e.g.: ai-sessions ask "
                     "\"where did I sort out the cert that keeps expiring\"")
    if args.command not in ("search", "ask") and args.query:
        parser.error(f"unexpected argument {args.query!r} "
                     f"(did you mean: ai-sessions search {args.query}?)")
    args.crashed_only = args.command == "crashed"

    if args.command == "pick":
        return cmd_pick(args)
    if args.command == "crashed":
        return cmd_crashed(args)
    if args.command == "search":
        return cmd_search(args)
    if args.command == "ask":
        return cmd_ask(args)
    return cmd_list(args)


if __name__ == "__main__":
    import signal
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # die quietly on | head
    sys.exit(main())
